<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_list_filter_configuration_tree" model="ir.ui.view">
        <field name="name">list.filter.configuration.tree</field>
        <field name="model">list.filter.configuration</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="model_id"/>
                <field name="date_field_id"/>
            </list>
        </field>
    </record>

    <record id="view_list_filter_configuration_form" model="ir.ui.view">
        <field name="name">list.filter.configuration.form</field>
        <field name="model">list.filter.configuration</field>
        <field name="arch" type="xml">
            <form string="List Filter Configuration">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <br/>
                    <group>
                        <group>
                            <field name="model_id"/>
                            <field name="view_id"/>
                            <field name="date_field_id"/>
                        </group>

                        <group>
                            <field name="created_view_id" readonly="1"/>
                        </group>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <record id="action_list_filter_configuration" model="ir.actions.act_window">
        <field name="name">List Filter Configuration</field>
        <field name="res_model">list.filter.configuration</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
            id="menu_list_filter_configuration"
            name="List Date Filters"
            parent="base.menu_automation"
            action="action_list_filter_configuration"
            sequence="1"/>

</odoo>