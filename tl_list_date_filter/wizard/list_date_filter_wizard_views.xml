<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_list_date_filter_wizard_form" model="ir.ui.view">
        <field name="name">list.date.filter.wizard.form</field>
        <field name="model">list.date.filter.wizard</field>
        <field name="arch" type="xml">
            <form string="Date Filter">
                <group>
                    <field name="config_id" invisible="1"/>
                    <field name="start_date" widget="date" />
                    <field name="end_date" invisible="1"/>
                </group>

                <footer>
                    <button
                            name="confirm"
                            type="object"
                            string="Apply Filter"
                            class="btn-primary"/>

                    <button
                            string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_list_date_filter_wizard" model="ir.actions.act_window">
        <field name="name">Date Filter</field>
        <field name="res_model">list.date.filter.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>