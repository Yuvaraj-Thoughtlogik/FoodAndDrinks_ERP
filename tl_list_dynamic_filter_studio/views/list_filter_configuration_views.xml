<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_list_filter_configuration_form_studio" model="ir.ui.view">
        <field name="name">list.filter.configuration.form.studio</field>
        <field name="model">list.filter.configuration</field>
        <field name="inherit_id"
               ref="tl_list_dynamic_filter.view_list_filter_configuration_form"/>
        <field name="arch" type="xml">

            <xpath expr="//header" position="inside">
                <button name="action_open_studio" type="object"
                        string="Design with Studio" class="btn-secondary"
                        invisible="not field_line_ids"/>
                <button name="action_reset_design" type="object"
                        string="Reset Design" class="btn-secondary"
                        confirm="This drops the Studio layout of this popup and rebuilds it from the filter fields. Continue?"
                        invisible="not studio_design"/>
            </xpath>

            <xpath expr="//group[@name='popup_config']" position="inside">
                <field name="studio_design" readonly="1"/>
                <field name="studio_view_count" invisible="1"/>
            </xpath>

            <xpath expr="//page[@name='fields']" position="inside">
                <div class="alert alert-info mt-2" role="alert"
                     invisible="not studio_design">
                    This popup is designed with Studio, so its layout is no longer
                    rebuilt automatically. Fields you add or remove here still get
                    their input created, but you have to place them in Studio.
                    Use <b>Reset Design</b> to go back to the generated layout.
                </div>
            </xpath>

        </field>
    </record>

</odoo>
