<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Round Batch Activity Wizard Form View -->
    <record id="view_round_batch_activity_wizard_form" model="ir.ui.view">
        <field name="name">round.batch.activity.wizard.form</field>
        <field name="model">round.batch.activity.wizard</field>
        <field name="arch" type="xml">
            <form string="Round Batch Activity">
                <sheet>
                    <group>
                        <field name="report_type" widget="radio" />
                    </group>
                </sheet>
                <footer>
                    <button name="action_view_lines" string="View Lines" type="object"
                        class="btn-primary" icon="fa-list" data-hotkey="q" />
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x" />
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to open the Wizard -->
    <record id="action_round_batch_activity_wizard" model="ir.actions.act_window">
        <field name="name">Round Batch Activity</field>
        <field name="res_model">round.batch.activity.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_round_batch_activity_wizard_form" />
    </record>
</odoo>
