<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Production Report Wizard Form View -->
    <record id="view_production_report_wizard_form" model="ir.ui.view">
        <field name="name">production.report.wizard.form</field>
        <field name="model">production.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Production Report">
                <sheet>
                    <!-- Row 1: Delivery Date From & To -->
                    <group>
                        <group>
                            <field name="delivery_date_from" widget="date" required="1"/>
                        </group>
                        <group>
                            <field name="delivery_date_to" widget="date" required="1"/>
                        </group>
                    </group>
                    <hr/>
                    <!-- Row 2: Report Type, Delivery Channel & Depot Checkboxes -->
                    <group>
                        <group colspan="4">
                            <field name="report_type" widget="radio" options="{'horizontal': true}" required="1"/>
                        </group>
                        <field name="all_production_report" invisible="1"/>
                        <field name="include_late_orders" invisible="1"/>
                        <field name="box_count" invisible="1"/>
                        <group invisible="all_production_report">
                            <field name="delivery_channel" widget="radio"
                                   options="{'horizontal': true}" readonly="box_count or include_late_orders" required="1"/>
                        </group>
                        <group string="Depot" colspan="4" invisible="delivery_channel == 'courier'">
                            <field name="depot_ids"
                                   widget="many2many_checkboxes"
                                   class="o_horizontal_checkboxes"
                                   nolabel="1"/>

                        </group>

                         <group string="Categories" colspan="4">
                            <!--                            <field name="category_ids"-->
                            <!--                                   widget="many2many_checkboxes"-->
                            <!--                                   class="o_horizontal_checkboxes"-->
                            <!--                                   nolabel="1"/>-->
                            <field name="category_ids"
                                   widget="many2many_tags"
                                   placeholder="All Categories"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_print_report" string="Print PDF" type="object"
                            class="btn-primary" icon="fa-print" data-hotkey="p"/>
                    <button name="action_view_lines" string="View Lines" type="object"
                            class="btn-secondary" icon="fa-list" data-hotkey="v"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to open the Production Report Wizard -->
    <record id="action_production_report_wizard" model="ir.actions.act_window">
        <field name="name">Production Report</field>
        <field name="res_model">production.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_production_report_wizard_form"/>
    </record>

    <!-- Component Line List View for Production Report "View Lines" - each
         row is a draft MO's raw material component line (move_raw_ids), e.g.
         "0.5 kg Cod Fillets Boned", not the MO's own top-level product. -->
    <record id="view_stock_move_production_report_list" model="ir.ui.view">
        <field name="name">stock.move.production.report.list</field>
        <field name="model">stock.move</field>
        <field name="arch" type="xml">
            <list string="Production Report Lines" create="0" delete="0" edit="0" expand="1">
                <field name="batch_delivery_date" string="Delivery Date"/>
                <field name="depot_id"/>
                <field name="component_categ_id" string="Category"/>
                <field name="product_id" string="Product / Box Contents"/>
                <field name="product_uom_qty" string="To Consume" sum="To Consume"/>
                <field name="special_requirements_notes" string="Special Notes" optional="show"/>
                <field name="production_sale_line_id" optional="hide"/>
                <field name="raw_material_production_id" string="Manufacturing Order" optional="hide"/>
                <field name="origin" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Component Line Search View for Production Report "View Lines" -->
    <record id="view_stock_move_production_report_search" model="ir.ui.view">
        <field name="name">stock.move.production.report.search</field>
        <field name="model">stock.move</field>
        <field name="arch" type="xml">
            <search string="Search Production Report Lines">
                <field name="product_id" string="Product / Box Contents"/>
                <field name="component_categ_id" string="Category"/>
                <field name="depot_id"/>
                <field name="batch_delivery_date" string="Delivery Date"/>
                <field name="raw_material_production_id" string="Manufacturing Order"/>
                <separator/>
                <group>
                    <filter string="Depot" name="group_by_depot" context="{'group_by': 'depot_id'}"/>
                    <filter string="Category" name="group_by_category" context="{'group_by': 'component_categ_id'}"/>
                    <filter string="Product" name="group_by_product" context="{'group_by': 'product_id'}"/>
                    <filter string="Delivery Date" name="group_by_delivery_date" context="{'group_by': 'batch_delivery_date'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>