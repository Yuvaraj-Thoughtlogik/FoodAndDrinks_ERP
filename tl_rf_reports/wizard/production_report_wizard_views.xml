<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Production Report Wizard Form View -->
    <record id="view_production_report_wizard_form" model="ir.ui.view">
        <field name="name">production.report.wizard.form</field>
        <field name="model">production.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Production Report">
                <sheet>
                    <!-- Row 1: Delivery Date From & To -->
                    <group>
                        <group>
                            <field name="delivery_date_from" widget="date" required="1"/>
                        </group>
                        <group>
                            <field name="delivery_date_to" widget="date" required="1"/>
                        </group>
                    </group>

                    <!-- Row 2: Late Order, Delivery Channel & Depot Checkboxes -->
                    <group>
                        <group colspan="4">
                            <field name="include_late_orders" string="Late Order"/>
                        </group>
                        <group>
                            <field name="delivery_channel" widget="radio"
                                   options="{'horizontal': true}" required="1"/>
                        </group>
                        <group string="Depot" colspan="4" invisible="delivery_channel == 'courier'">
                            <field name="depot_ids"
                                   widget="many2many_checkboxes"
                                   class="o_horizontal_checkboxes"
                                   nolabel="1"/>
                        </group>

                        <group string="Categories" colspan="4">
                            <field name="category_ids"
                                   widget="many2many_checkboxes"
                                   class="o_horizontal_checkboxes"
                                   nolabel="1"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_print_report" string="Print PDF" type="object"
                            class="btn-primary" icon="fa-print" data-hotkey="p"/>
                    <button name="action_print_label" string="Print Label" type="object"
                            class="btn-primary" icon="fa-tag" data-hotkey="l"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to open the Production Report Wizard -->
    <record id="action_production_report_wizard" model="ir.actions.act_window">
        <field name="name">Production Report</field>
        <field name="res_model">production.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_production_report_wizard_form"/>
    </record>
</odoo>