<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Packing List Wizard Form View -->
    <record id="view_packing_list_wizard_form" model="ir.ui.view">
        <field name="name">packing.list.wizard.form</field>
        <field name="model">packing.list.wizard</field>
        <field name="arch" type="xml">
            <form string="Packing List Report">
                <sheet>
                    <!-- Row 1: Delivery Date From & To on the same line -->
                    <group>
                        <group>
                            <field name="delivery_date_from" widget="date" required="1"/>
                        </group>
                        <group>
                            <field name="delivery_date_to" widget="date" required="1"/>
                        </group>
                    </group>

                    <!-- Row 2: Late Order, Delivery Channel & Depot Checkboxes -->
                    <group>
                        <group colspan="4">
                            <field name="include_late_orders" string="Late Order"/>
                        </group>
                        <group>
                            <field name="delivery_channel" widget="radio"
                                   options="{'horizontal': true}" required="1"/>
                        </group>
                        <group string="Depot" colspan="4" invisible="delivery_channel == 'courier'">
                            <field name="depot_ids"
                                   widget="many2many_checkboxes"
                                   class="o_horizontal_checkboxes"
                                   nolabel="1"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_print_report" string="Print PDF" type="object"
                            class="btn-primary" icon="fa-print" data-hotkey="p"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to open the Packing List Wizard -->
    <record id="action_packing_list_wizard" model="ir.actions.act_window">
        <field name="name">Packing List</field>
        <field name="res_model">packing.list.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_packing_list_wizard_form"/>
    </record>

    <!-- Packing List Menu Item under Round Management -> Reporting -->
    <menuitem id="menu_report_packing_list"
              name="Packing List"
              parent="tl_rf_reports.menu_round_reporting_root"
              action="action_packing_list_wizard"
              sequence="20"/>
</odoo>
