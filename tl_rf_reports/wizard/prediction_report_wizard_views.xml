<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Prediction Report Wizard Form View -->
    <record id="view_prediction_report_wizard_form" model="ir.ui.view">
        <field name="name">prediction.report.wizard.form</field>
        <field name="model">prediction.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Prediction Report">
                <sheet>
                    <!-- Row 1: Delivery Date From & To -->
                    <group>
                        <group>
                            <field name="delivery_date_from" widget="date" required="1" />
                        </group>
                        <group>
                            <field name="delivery_date_to" widget="date" required="1" />
                        </group>
                    </group>

                    <!-- Row 2: Delivery Channel Selection -->
                    <group>
                        <group colspan="4">
                            <field name="delivery_channel" widget="radio"
                                options="{'horizontal': true}" required="1" />
                        </group>
                    </group>

                    <!-- Row 3: Depot Checkboxes -->
                    <group string="Depot" colspan="4" invisible="delivery_channel == 'courier'">
                        <field name="depot_ids"
                            widget="many2many_checkboxes"
                            class="o_horizontal_checkboxes"
                            nolabel="1" />
                    </group>

                    <!-- Row 4: Product Category Multi-Select -->
                    <group>
                        <group colspan="4">
                            <field name="categ_ids"
                                widget="many2many_tags"
                                placeholder="Select Product Categories..." />
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_print_report" string="Print PDF" type="object"
                        class="btn-secondary" icon="fa-print" data-hotkey="p" />
                    <button name="action_view_lines" string="View Lines" type="object"
                        class="btn-primary" icon="fa-list" data-hotkey="q"
                        invisible="delivery_channel == 'both'" />
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x" />
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to open Prediction Report Wizard -->
    <record id="action_prediction_report_wizard" model="ir.actions.act_window">
        <field name="name">Prediction Report</field>
        <field name="res_model">prediction.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_prediction_report_wizard_form" />
    </record>

    <!-- Prediction Report Line List View -->
   <record id="view_prediction_report_line_tree" model="ir.ui.view">
        <field name="name">prediction.report.line.list</field>
        <field name="model">prediction.report.line</field>
        <field name="arch" type="xml">
            <list string="Prediction Report Lines" create="0" edit="1" editable="bottom">
                <header>
                    <button name="action_create_rfq" string="Create PO" type="object"
                        class="btn-primary" display="always" icon="fa-shopping-cart" />
                </header>
                <field name="vendor_ids" column_invisible="True" />
                <field name="product_id" readonly="1" />
                <field name="product_code" optional="show" readonly="1" />
                <field name="categ_id" readonly="1" />
                
                <!-- Required Qty vs Editable Ordered Qty -->
                <field name="required_qty" sum="Total Required Qty" readonly="1" />
                <field name="ordered_qty" sum="Total Ordered Qty" />
                <field name="uom_id" readonly="1" string="Unit of Measure" />
                <field name="price_unit" optional="show" />
                <!-- Status Badge -->
                
                
                <!-- Dynamic Vendor Filter & Editable Price -->
                <field name="vendor_id" options="{'no_create': True}" domain="[('id', 'in', vendor_ids)]" />
                
                
                <field name="purchase_order_id" readonly="1" optional="show" />
                <field name="order_status" widget="badge" 
                   decoration-info="order_status in ('draft', 'sent')" 
                   decoration-warning="order_status == 'to_approve'" 
                   decoration-success="order_status in ('purchase', 'done')" 
                   decoration-danger="order_status == 'cancel'" />
            
            
            <button name="action_view_purchase_order" 
                    type="object" 
                    string="View PO" 
                    icon="fa-external-link" 
                    class="btn-link" 
                    invisible="purchase_order_id == False" />
            </list>
        </field>
    </record>

    <!-- Prediction Report Line Form View -->
    <record id="view_prediction_report_line_form" model="ir.ui.view">
        <field name="name">prediction.report.line.form</field>
        <field name="model">prediction.report.line</field>
        <field name="arch" type="xml">
            <form string="Prediction Report Line" create="0">
                <header>
                    <button name="action_create_rfq" string="Create PO" type="object"
                        class="btn-primary" icon="fa-shopping-cart" />
                    <field name="order_status" widget="statusbar" statusbar_visible="draft,sent,purchase,done" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="vendor_ids" invisible="1" />
                            <field name="product_id" readonly="1" />
                            <field name="product_code" readonly="1" />
                            <field name="categ_id" readonly="1" />
                            <field name="purchase_order_id" readonly="1" />
                        </group>
                        <group>
                            <field name="required_qty" readonly="1" />
                            <field name="ordered_qty" />
                            <field name="uom_id" readonly="1" />
                            <field name="vendor_id" options="{'no_create': True}" domain="[('id', 'in', vendor_ids)]" />
                            <field name="price_unit" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Prediction Report Line Search View -->
    <record id="view_prediction_report_line_search" model="ir.ui.view">
        <field name="name">prediction.report.line.search</field>
        <field name="model">prediction.report.line</field>
        <field name="arch" type="xml">
            <search string="Search Prediction Report Lines">
                <field name="product_id" />
                <field name="vendor_id" />
                <field name="categ_id" />
                <separator />
                <filter string="Without Vendor" name="no_vendor" domain="[('vendor_id', '=', False)]" />
                <group>
                    <filter string="Vendor" name="group_by_vendor" domain="[]" context="{'group_by': 'vendor_id'}" />
                    <filter string="Category" name="group_by_category" domain="[]" context="{'group_by': 'categ_id'}" />
                    <filter string="Product" name="group_by_product" domain="[]" context="{'group_by': 'product_id'}" />
                </group>
            </search>
        </field>
    </record>
    
    
    <record id="view_prediction_report_line_form" model="ir.ui.view">
    <field name="name">prediction.report.line.form</field>
    <field name="model">prediction.report.line</field>
    <field name="arch" type="xml">
        <form string="Prediction Report Line" create="0">
            <header>
                <button name="action_create_rfq" string="Create PO" type="object"
                    class="btn-primary" icon="fa-shopping-cart"
                    invisible="purchase_order_id != False" />
                <field name="order_status" widget="statusbar" statusbar_visible="draft,sent,purchase,done" />
            </header>
            <sheet>
                <!-- PO Smart Button -->
                <div class="oe_button_box" name="button_box">
                    <button name="action_view_purchase_order"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-credit-card"
                        invisible="purchase_order_id == False">
                        <div class="o_stat_info">
                            <span class="o_stat_text">Purchase Order</span>
                        </div>
                    </button>
                </div>

                <group>
                    <group>
                        <field name="vendor_ids" invisible="1" />
                        <field name="product_id" readonly="1" />
                        <field name="product_code" readonly="1" />
                        <field name="categ_id" readonly="1" />
                        <field name="purchase_order_id" readonly="1" />
                    </group>
                    <group>
                        <field name="required_qty" readonly="1" />
                        <field name="ordered_qty" />
                        <field name="uom_id" readonly="1" />
                        <field name="vendor_id" options="{'no_create': True}" domain="[('id', 'in', vendor_ids)]" />
                        <field name="price_unit" />
                    </group>
                </group>
            </sheet>
        </form>
    </field>
</record>
</odoo>

