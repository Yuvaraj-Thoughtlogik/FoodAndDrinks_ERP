<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Active Batch Report Wizard Form View -->
    <record id="view_active_batch_report_wizard_form" model="ir.ui.view">
        <field name="name">active.batch.report.wizard.form</field>
        <field name="model">active.batch.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Active Batch Report">
                <sheet>
                    <group>
                        <group>
                            <label for="weeks" string="With in" />
                            <div class="oe_row">
                                <field name="weeks" required="1" nolabel="1" class="oe_inline" />
                                <span class="oe_inline">weeks</span>
                            </div>
                        </group>
                    </group>
                    <group>
                        <field name="round_ids"
                            widget="many2many_tags"
                            placeholder="All Rounds (leave empty for all)"
                            options="{'no_create': True, 'no_create_edit': True}" />
                    </group>
                </sheet>
                <footer>
                    <button name="action_print_report"
                        string="Print"
                        type="object"
                        class="btn-primary"
                        icon="fa-print"
                        data-hotkey="p" />
                    <button string="Cancel"
                        class="btn-secondary"
                        special="cancel"
                        data-hotkey="x" />
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to open the Wizard -->
    <record id="action_active_batch_report_wizard" model="ir.actions.act_window">
        <field name="name">Active Batch Report</field>
        <field name="res_model">active.batch.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_active_batch_report_wizard_form" />
    </record>
</odoo>