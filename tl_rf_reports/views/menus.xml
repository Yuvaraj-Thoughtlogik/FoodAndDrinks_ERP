<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Reporting Menu under Round Management (Placed after Driver Rounds, before Configuration) -->
    <menuitem id="menu_round_reporting_root"
        name="Reporting"
        parent="round_management.menu_round_management_root"
        sequence="50" />
    <!-- Active Batch Report Menu Item under Round Management -> Reporting -->
    <menuitem id="menu_report_active_batch"
        name="Active Batch Report"
        parent="menu_round_reporting_root"
        action="action_active_batch_report_wizard"
        sequence="5" />
    <!-- Dock Weight Breakdown Report Menu Item -->
    <menuitem id="menu_report_dock_weight_breakdown"
        name="Dock Weight Breakdown Report"
        parent="menu_round_reporting_root"
        action="action_dock_weight_breakdown_wizard"
        sequence="10" />
    <!-- Requirement Report Menu Item under Round Management -> Reporting -->
    <menuitem id="menu_report_requirement"
        name="Requirement Report"
        parent="menu_round_reporting_root"
        action="action_requirement_report_wizard"
        sequence="15" />

    <!-- Prediction Report Menu Item under Round Management -> Reporting (placed right after
    Requirement Report) -->
    <menuitem id="menu_report_prediction"
        name="Prediction Report"
        parent="menu_round_reporting_root"
        action="action_prediction_report_wizard"
        sequence="16" />

    <!-- Packing List Menu Item under Round Management -> Reporting -->
    <menuitem id="menu_report_packing_list"
        name="Packing List Report"
        parent="menu_round_reporting_root"
        action="action_packing_list_wizard"
        sequence="20" />


    <!-- Delivery Note Round Report Menu Item under Round Management -> Reporting -->
    <menuitem id="menu_report_delivery_note_round"
        name="Delivery Note Round Report"
        parent="menu_round_reporting_root"
        action="action_delivery_note_round_wizard"
        sequence="30" />

    <!-- Production Report Menu Item under Round Management -> Reporting -->
    <menuitem id="menu_report_production_report"
        name="Production Report"
        parent="menu_round_reporting_root"
        action="action_production_report_wizard"
        sequence="40" />

    <record id="action_bulk_confirm_orders" model='ir.actions.server'>
        <field name="name">Bulk Confirm Orders</field>
        <field name="model_id" ref="sale.model_sale_order" />
        <field name="binding_model_id" ref="sale.model_sale_order" />
        <field name="state">code</field>
        <field name="code">action = model.bulk_confirm_orders()</field>

    </record>
</odoo>