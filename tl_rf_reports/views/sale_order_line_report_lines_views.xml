<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Read-only list of sale.order.line.report_lines (see
         SaleOrderLine._get_report_line_vals) - the same rows the Packing
         List / Production reports read, exposed here for browsing/grouping
         instead of only being consumed by a PDF. -->
    <record id="view_sale_order_line_report_lines_list" model="ir.ui.view">
        <field name="name">sale.order.line.report_lines.list</field>
        <field name="model">sale.order.line.report_lines</field>
        <field name="arch" type="xml">
            <list string="Order Lines" create="0" delete="0" edit="0" expand="2">
                <field name="box_content" optional="show"/>
                <field name="batch_id" optional="show"/>
                <field name="qty" string="Quantity"/>
                <field name="name" string="Description"/>
                <field name="delivery_channel" optional="hide"/>
                <field name="categ_id" optional="hide"/>
                <field name="product_id" optional="hide"/>
                <field name="notes" optional="show"/>
                <field name="late_order" optional="show"/>
                <field name="from_bom" optional="hide"/>
                <field name="sale_order_id" string="Order"/>
                <field name="order_partner_id" string="Customer" optional="hide"/>
                <field name="delivery_date" optional="show"/>
                <field name="depot_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_sale_order_line_report_lines_search" model="ir.ui.view">
        <field name="name">sale.order.line.report_lines.search</field>
        <field name="model">sale.order.line.report_lines</field>
        <field name="arch" type="xml">
            <search string="Search Order Lines">
                <field name="product_id"/>
                <field name="sale_order_id"/>
                <field name="order_partner_id"/>
                <field name="categ_id"/>
                <field name="delivery_date"/>
                <separator/>
                <filter string="Courier Delivery" name="courier" domain="[('delivery_channel', '=', 'courier')]"/>
                <filter string="Regal Van Delivery" name="regal_van" domain="[('delivery_channel', 'in', ['regal_van', False])]"/>
                <separator/>
                <filter string="Late Order" name="late_order" domain="[('late_order', '=', True)]"/>
                <group>
                    <filter string="Delivery Channel" name="group_by_channel" context="{'group_by': 'delivery_channel'}"/>
                    <filter string="Product Category" name="group_by_category" context="{'group_by': 'categ_id'}"/>
                    <filter string="Product" name="group_by_product" context="{'group_by': 'product_id'}"/>
                    <filter string="Delivery Date" name="group_by_delivery_date" context="{'group_by': 'delivery_date'}"/>
                    <filter string="Depot" name="group_by_depot" context="{'group_by': 'depot_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sale_order_line_report_lines" model="ir.actions.act_window">
        <field name="name">Order Lines</field>
        <field name="res_model">sale.order.line.report_lines</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_sale_order_line_report_lines_list"/>
        <field name="search_view_id" ref="view_sale_order_line_report_lines_search"/>
        <field name="context">{'search_default_group_by_channel': 1, 'search_default_group_by_category': 1}</field>
    </record>
</odoo>
