<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="view_picking_tree_round_management_report" model="ir.ui.view">
            <field name="name">stock.picking.tree.round.management.report</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.vpicktree"/>
            <field name="arch" type="xml">
                <xpath expr="//header" position="inside">
                    <button
                        name="%(tl_rf_reports.action_delivery_note_round_wizard)d"
                        string="Delivery Report"
                        type="action"
                        display="always"
                    />
                </xpath>
            </field>
        </record>
    </data>
</odoo>