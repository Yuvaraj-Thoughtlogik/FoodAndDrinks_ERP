<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Paper Format: A4 portrait, 10mm top/bottom, 9mm left/right -->
    <record id="paperformat_delivery_note_round_van_report" model="report.paperformat">
        <field name="name">Delivery Note Round Report (Van) A4</field>
        <field name="default" eval="False" />
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">20</field>
        <field name="margin_left">9</field>
        <field name="margin_right">9</field>
        <field name="header_line" eval="False" />
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <!-- Report Action -->
    <record id="action_report_delivery_note_round_van" model="ir.actions.report">
        <field name="name">Delivery Note Round Report (Van)</field>
        <field name="model">delivery.note.round.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">tl_rf_reports.report_delivery_note_round_van</field>
        <field name="report_file">tl_rf_reports.report_delivery_note_round_van</field>
        <field name="print_report_name">('Delivery_Note_Round_Van_' +
            (object.delivery_date_from.strftime('%Y%m%d') if object.delivery_date_from else ''))</field>
        <field name="paperformat_id" ref="paperformat_delivery_note_round_van_report" />
        <field name="binding_model_id" eval="False" />
        <field name="binding_type">report</field>
    </record>

    <!-- QWeb Template (100% div-based, no tables) -->
    <template id="report_delivery_note_round_van">
        <t t-call="web.html_container">
            <t t-if="batch_groups">
                <t t-foreach="batch_groups" t-as="group">
                    <t t-foreach="group['pages']" t-as="page">
                    <div class="article"
                        t-attf-style="#{'page-break-before: always;' if not (group_first and page_first) else ''}">
                        <div
                            style="font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif; font-size: 13.5px; line-height: 1.25; color: #000000; width: 100%; padding: 0; margin: 0; box-sizing: border-box;">

                            <!-- ==================== HEADER (repeated every page) ==================== -->
                            <div style="width: 100%; margin-bottom: 4px;">
                                <div
                                    style="float: left; width: 33%; font-size: 14px; font-weight: bold; white-space: nowrap; padding-right: 8px; box-sizing: border-box;">
                                    DELIVERY NOTE FOR ROUND:
                                </div>
                                <div
                                    style="float: left; width: 29%; font-size: 12px; font-weight: bold; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; padding-right: 10px; box-sizing: border-box;">
                                    <t t-esc="group['batch_name']" />
                                </div>
                                <div
                                    style="float: left; width: 11%; font-size: 12px; font-weight: bold; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                    <t t-esc="group['batch_code']" />
                                </div>
                                <div
                                    style="float: right; width: 27%; font-size: 12px; font-weight: bold; text-align: right; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                    <t t-esc="group['depot_name']" />
                                </div>
                                <div style="clear: both;" />
                            </div>

                            <div style="width: 100%; margin-bottom: 12px;">
                                <div
                                    style="float: left; width: 70%; font-size: 13.5px; white-space: nowrap;">
                                    For Delivery on: <t t-esc="group['delivery_date']" />
                                </div>
                                <div
                                    style="float: left; width: 30%; font-size: 13.5px; white-space: nowrap;">
                                    <t t-esc="group['total_deliveries']" />
                                    &#160;&#160;&#160;Deliveries </div>
                                <div style="clear: both;" />
                            </div>

                            <!-- ==================== DROPS (this page only) ==================== -->
                            <t t-foreach="page['drops']" t-as="drop">
                                <div
                                    style="border-top: 1.5px solid #000000; padding: 6px 0 8px 0; margin-bottom: 4px; page-break-inside: avoid; width: 100%; box-sizing: border-box;">

                                    <!-- Customer / Address / Phone -->
                                    <div style="width: 100%; margin-bottom: 3px;">
                                        <div
                                            style="float: left; width: 28%; font-size: 13.5px; color: #000000; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                            <t t-esc="drop['cust']" />
                                        </div>
                                        <div
                                            style="float: left; width: 54%; font-size: 13.5px; font-weight: bold; color: #000000; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; padding-right: 8px; box-sizing: border-box;">
                                            <t t-esc="drop['addr']" />
                                        </div>
                                        <div
                                            style="float: right; width: 18%; font-size: 13.5px; font-weight: bold; color: #000000; text-align: right; white-space: nowrap;">
                                            <t t-esc="drop['tel']" />
                                        </div>
                                        <div style="clear: both;" />
                                    </div>

                                    <!-- Items list & Delivery Note -->
                                    <div style="width: 100%;">
                                        <div
                                            style="float: left; width: 68%; padding-left: 20px; box-sizing: border-box;">
                                            <t t-foreach="drop['items']" t-as="item">
                                                <div
                                                    style="font-size: 13.5px; line-height: 1.5;">
                                                    <t t-esc="item" />
                                                </div>
                                            </t>
                                        </div>
                                        <div
                                            style="float: right; width: 32%; font-size: 13px; font-weight: bold; color: #000000; text-align: right;">

                                            <!-- Delivery order barcode (Code128 of the
                                                 outgoing picking, e.g. WH/OUT/00012).
                                                 The image is a base64 data URI built in
                                                 Python, so wkhtmltopdf does not have to
                                                 call /report/barcode/ over HTTP. -->
                                            <t t-if="drop['barcode_src']">
                                                <div style="margin-bottom: 4px;">
                                                    <!-- Fixed-width inline-block wrapper: it is
                                                         right-aligned by the parent column, while
                                                         its own text-align centres the caption
                                                         under the barcode instead of letting the
                                                         caption inherit the right alignment. -->
                                                    <div
                                                        style="display: inline-block; width: 190px; text-align: center;">
                                                        <img t-att-src="drop['barcode_src']"
                                                            t-att-alt="drop['picking_name']"
                                                            style="display: block; width: 190px; height: 38px;" />
                                                        <div
                                                            style="font-size: 10px; font-weight: normal; letter-spacing: 0.4px; line-height: 1.2; margin-top: 1px; text-align: center;">
                                                            <t t-esc="drop['picking_name']" />
                                                        </div>
                                                    </div>
                                                </div>
                                            </t>

                                            <t t-if="drop['note']">
                                                <div>
                                                    <t t-esc="drop['note']" />
                                                </div>
                                            </t>
                                        </div>
                                        <div style="clear: both;" />
                                    </div>

                                    <!-- Payment Methods / Order No / Price / Zone -->
                                    <div style="width: 100%; margin-top: 4px;">
                                        <!-- Order No -->
                                        <div
                                            style="float: left; width: 15%; font-size: 13px; color: #000000; white-space: nowrap;">
                                            Order No: <t t-esc="drop['order_no']" />
                                        </div>

                                        <!-- Payment Methods -->
                                        <div
                                            style="float: left; width: 63%; text-align: left; padding-left: 20px;margin-top: 30px; box-sizing: border-box; white-space: nowrap;">
                                            <t
                                                t-foreach="[('Card Reader', drop['pay']['card_reader']), ('K/B', drop['pay']['kb']), ('LNP', drop['pay']['lnp']), ('Cash', drop['pay']['cash']), ('Cheque', drop['pay']['cheque']), ('Card', drop['pay']['card'])]"
                                                t-as="pm">
                                                <span
                                                    style="display: inline-block; margin-right: 12px; font-size: 13px; color: #000000; white-space: nowrap;">
                                                    <span
                                                        style="margin-right: 4px; vertical-align: middle;">
                                                        <t t-esc="pm[0]" />
                                                    </span>
                                                    <t t-if="pm[1]">
                                                        <span
                                                            style="display: inline-block; width: 13px; height: 13px; border: 1.5px solid #000000; text-align: center; line-height: 11px; font-size: 11px; font-weight: bold; vertical-align: middle;">
                                                            &#10006;</span>
                                                    </t>
                                                    <t t-else="">
                                                        <span
                                                            style="display: inline-block; width: 13px; height: 13px; border: 1.5px solid #000000; vertical-align: middle;" />
                                                    </t>
                                                </span>
                                            </t>
                                        </div>

                                        <!-- Price -->
                                        <div
                                            style="float: left; width: 12%; text-align: right; font-size: 14.5px; font-weight: bold; color: #000000; white-space: nowrap;">
                                            <t t-esc="drop['price']" />
                                        </div>

                                        <!-- Zone -->
                                        <div
                                            style="float: right; width: 10%; text-align: right; font-size: 14.5px; font-weight: bold; color: #000000; white-space: nowrap;">
                                            <!-- <t t-esc="drop['zone']" /> -->
                                        </div>

                                        <div style="clear: both;" />
                                    </div>

                                </div>
                            </t>

                        </div>
                    </div>

                    <!-- FOOTER: page number is pre-computed in Python across the WHOLE
                         report (see _number_pages_continuously), so it stays continuous
                         even when a batch's drops overflow onto extra pages. -->
                    <div class="footer"
                        style="font-family: Arial, Helvetica, sans-serif; font-size: 13px; color: #000000; border-top: none; padding: 0; width: 100%;">
                        <div style="position: relative; width: 100%; text-align: center;">
                            <span style="font-size: 13px; font-weight: normal;">
                                <t t-esc="page['page_number']" />
                            </span>
                            <span style="position: absolute; right: 0; top: 0; font-size: 13px;">
                                Printed at:
                                <t t-esc="printed_at" />
                            </span>
                        </div>
                    </div>
                    </t>
                </t>
            </t>
        </t>
    </template>
</odoo>