<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Paper Format: A4 portrait, 10mm top/bottom, 9mm left/right -->
    <record id="paperformat_delivery_note_round_report" model="report.paperformat">
        <field name="name">Delivery Note Round Report A4</field>
        <field name="default" eval="False" />
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">9</field>
        <field name="margin_right">9</field>
        <field name="header_line" eval="False" />
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <!-- Report Action -->
    <record id="action_report_delivery_note_round" model="ir.actions.report">
        <field name="name">Delivery Note Round Report</field>
        <field name="model">delivery.note.round.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">tl_rf_reports.report_delivery_note_round</field>
        <field name="report_file">tl_rf_reports.report_delivery_note_round</field>
        <field name="print_report_name">('Delivery_Note_Round_' +
            (object.delivery_date_from.strftime('%Y%m%d') if object.delivery_date_from else ''))</field>
        <field name="paperformat_id" ref="paperformat_delivery_note_round_report" />
        <field name="binding_model_id" eval="False" />
        <field name="binding_type">report</field>
    </record>

    <!-- QWeb Template with Pure Inline Styles (No style tag) -->
    <template id="report_delivery_note_round">
        <t t-call="web.html_container">
            <t t-if="batch_groups">
                <t t-foreach="batch_groups" t-as="group">
                    <div class="article"
                        t-attf-style="#{'page-break-before: always;' if not group_first else ''}">
                        <div
                            style="font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif; font-size: 14px; line-height: 1.25; color: #000000; width: 100%; padding: 0; margin: 0;">

                            <!-- ==================== HEADER ==================== -->
                            <table
                                style="width: 100%; table-layout: fixed; border-collapse: collapse; border: none !important; margin-bottom: 12px;">
                                <colgroup>
                                    <col style="width: 33%;" />
                                    <col style="width: 25%;" />
                                    <col style="width: 24%;" />
                                    <col style="width: 18%;" />
                                </colgroup>
                                <tr
                                    style="font-size: 17px; font-weight: bold; border: none !important;">
                                    <td
                                        style="padding: 0; vertical-align: baseline; white-space: nowrap; border: none !important;">
                                        DELIVERY NOTE FOR ROUND:
                                    </td>
                                    <td
                                        style="padding: 0 0 0 25px; vertical-align: baseline; white-space: nowrap; border: none !important;">
                                        <t t-esc="group['batch_name']" />
                                    </td>
                                    <td
                                        style="padding: 0; vertical-align: baseline; white-space: nowrap; border: none !important;">
                                        <t t-esc="group['batch_code']" />
                                    </td>
                                    <td
                                        style="padding: 0; vertical-align: baseline; text-align: right; font-size: 15px; white-space: nowrap; border: none !important;">
                                        <t t-esc="group['depot_name']" />
                                    </td>
                                </tr>
                                <tr
                                    style="font-size: 13.5px; font-weight: normal; border: none !important;">
                                    <td
                                        style="padding: 8px 0 0 0; vertical-align: baseline; white-space: nowrap; border: none !important;">
                                        For Delivery on: <t t-esc="group['delivery_date']" />
                                    </td>
                                    <td style="padding: 8px 0 0 0; border: none !important;" />
                                    <td style="padding: 8px 0 0 0; border: none !important;" />
                                    <td
                                        style="padding: 8px 0 0 25px; vertical-align: baseline; white-space: nowrap; border: none !important;">
                                        <t t-esc="group['total_deliveries']" />
                                        &#160;&#160;&#160;Deliveries </td>
                                </tr>
                            </table>

                            <!-- ==================== DROPS ==================== -->
                            <t t-foreach="group['drops']" t-as="drop">
                                <table
                                    t-attf-style="width: 100%; table-layout: fixed; border-collapse: collapse; border: none; font-size: 13.5px; page-break-inside: avoid; margin-top: #{'15px' if drop_first else '8px'};">
                                    <colgroup>
                                        <col style="width: 20.5%;" />
                                        <col style="width: 6.0%;" />
                                        <col style="width: 42.2%;" />
                                        <col style="width: 11.5%;" />
                                        <col style="width: 19.8%;" />
                                    </colgroup>

                                    <!-- separator rule -->
                                    <tr style="border: none !important;">
                                        <td colspan="5"
                                            style="border: none !important; border-top: 1.5px solid #000000 !important; padding: 0; font-size: 0; line-height: 0;">
                                            &#160;</td>
                                    </tr>

                                    <!-- customer / address / telephone -->
                                    <tr style="border: none !important;">
                                        <td colspan="2"
                                            style="border: none !important; padding: 5px 0 0 0; vertical-align: top; text-align: left; font-size: 13.5px; color: #000;">
                                            <t t-esc="drop['cust']" />
                                        </td>
                                        <td colspan="2"
                                            style="border: none !important; padding: 5px 8px 0 8px; vertical-align: top; text-align: left; font-size: 13.5px; font-weight: bold; color: #000; white-space: nowrap; overflow: hidden;">
                                            <t t-esc="drop['addr']" />
                                        </td>
                                        <td
                                            style="border: none !important; padding: 5px 0 0 0; vertical-align: top; text-align: right; font-size: 13.5px; font-weight: bold; color: #000; white-space: nowrap;">
                                            <t t-esc="drop['tel']" />
                                        </td>
                                    </tr>

                                    <!-- items + order no / delivery note -->
                                    <tr style="border: none !important;">
                                        <td colspan="3"
                                            style="border: none !important; padding: 4px 8px 0 15px; vertical-align: top; text-align: left;">
                                            <t t-foreach="drop['items']" t-as="item">
                                                <div
                                                    style="color: #1a3fb0; font-size: 13.5px; line-height: 1.35;">
                                                    <t t-esc="item" />
                                                </div>
                                            </t>
                                            <div
                                                style="color: #000000; font-size: 13px; margin-top: 3px;">
                                                Order No: <t t-esc="drop['order_no']" />
                                            </div>
                                        </td>
                                        <td colspan="2"
                                            style="border: none !important; padding: 4px 0 0 0; vertical-align: top; text-align: right; font-size: 13px; font-weight: bold; color: #000; white-space: nowrap;">
                                            <t t-esc="drop['note']" />
                                        </td>
                                    </tr>

                                    <!-- payment methods / price / zone -->
                                    <tr style="border: none !important;">
                                        <td style="border: none !important; padding: 0;" />
                                        <td colspan="2"
                                            style="border: none !important; padding: 5px 0 0 0; text-align: left; vertical-align: middle; white-space: nowrap;">
                                            <t
                                                t-foreach="[('Card Reader', drop['pay']['card_reader']), ('K/B', drop['pay']['kb']), ('LNP', drop['pay']['lnp']), ('Cash', drop['pay']['cash']), ('Cheque', drop['pay']['cheque']), ('Card', drop['pay']['card'])]"
                                                t-as="pm">
                                                <span
                                                    style="display: inline-block; margin-right: 12px; font-size: 13px; color: #000; white-space: nowrap;">
                                                    <span
                                                        style="margin-right: 4px; vertical-align: middle;">
                                                        <t t-esc="pm[0]" />
                                                    </span>
                                                    <t t-if="pm[1]">
                                                        <span
                                                            style="display: inline-block; width: 13px; height: 13px; border: 1.5px solid #000000; text-align: center; line-height: 11px; font-size: 10px; font-weight: bold; vertical-align: middle;">
                                                            &#10005;</span>
                                                    </t>
                                                    <t t-else="">
                                                        <span
                                                            style="display: inline-block; width: 13px; height: 13px; border: 1.5px solid #000000; vertical-align: middle;" />
                                                    </t>
                                                </span>
                                            </t>
                                        </td>
                                        <td
                                            style="border: none !important; padding: 5px 0 0 0; text-align: right; font-size: 14.5px; font-weight: bold; color: #000; vertical-align: middle; white-space: nowrap;">
                                            <t t-esc="drop['price']" />
                                        </td>
                                        <td
                                            style="border: none !important; padding: 5px 0 0 0; text-align: right; font-size: 14.5px; font-weight: bold; color: #000; vertical-align: middle; white-space: nowrap;">
                                            <t t-esc="drop['zone']" />
                                        </td>
                                    </tr>

                                </table>
                            </t>

                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>