<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Driver Packing List report.

        Reuses the paper format defined for the standard Packing List
        (paperformat_packing_list_report, in report/packing_list_report_views.xml).
        IMPORTANT: in __manifest__.py 'data', this file must be listed AFTER
        report/packing_list_report_views.xml so that xmlid exists when this
        record is loaded.

        Data is produced by report.tl_rf_reports.report_driver_packing_list_document
        (report/driver_packing_list_report.py): Regal Van Delivery only, Normal +
        Late orders included, BOM-aware (Kit BOMs exploded into components,
        Manufacture-type BOMs and no-BOM products shown as-is), quantities
        consolidated per batch, grouped Batch -> Category (Frozen, Fresh, then
        others alphabetically) -> Product Sort Number. Quantities always print
        with 2 decimal places and there is no "Boxes" total line, per the
        confirmed expected output ("Drivers Packing List : Customer").
    -->
    <record id="action_report_driver_packing_list" model="ir.actions.report">
        <field name="name">Driver Packing List Report</field>
        <field name="model">packing.list.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">tl_rf_reports.report_driver_packing_list_document</field>
        <field name="report_file">tl_rf_reports.report_driver_packing_list_document</field>
        <field name="print_report_name">'Driver_Packing_List_' + (object.delivery_date_from.strftime('%Y%m%d') if object.delivery_date_from else '')</field>
        <field name="paperformat_id" ref="paperformat_packing_list_report"/>
        <field name="binding_model_id" eval="False"/>
    </record>

    <template id="report_driver_packing_list_document">
        <t t-call="web.html_container">
            <style type="text/css">
                .driver-packing-page {
                font-family: Arial, "Helvetica Neue", Helvetica, sans-serif !important;
                color: #000000 !important;
                background: #ffffff !important;
                width: 100% !important;
                padding: 0 !important;
                margin: 0 !important;
                }
            </style>

            <t t-if="batch_groups">
                <t t-foreach="batch_groups" t-as="group">
                    <t t-foreach="group['pages']" t-as="page">
                        <!--
                            Page-break rule (same convention as the Factory Only
                            Packing List): always start a new batch on a fresh
                            page, and break before any continuation page of the
                            same batch.
                        -->
                        <div class="article driver-packing-page"
                             t-attf-style="#{'page-break-before: always;' if not (group_first and page_first) else ''}">
                            <!-- Batch Header: repeated on every page -->
                            <div style="width: 100%; border: none !important; margin-bottom: 12px;">
                                <div style="float: left; width: 60%; border: none !important;">
                                    <div style="font-size: 22px; font-weight: bold; color: #000000; line-height: 1.2;">
                                        Drivers Packing List : Customer
                                    </div>
                                    <div style="font-size: 16px; font-weight: bold; color: #000000; margin-top: 4px; line-height: 1.2;">
                                        <span style="display: inline-block; min-width: 75px;">
                                            <t t-esc="group['batch_code']"/>
                                        </span>
                                        <span style="margin-left: 20px;">
                                            <t t-esc="group['batch_name']"/>
                                        </span>
                                    </div>
                                </div>
                                <div style="float: right; width: 40%; text-align: right; border: none !important;">
                                    <div style="font-size: 16px; font-weight: bold; color: #000000; line-height: 1.2;">
                                        <span>Delivery On:</span>
                                        <t t-esc="group['delivery_date']"/>
                                    </div>
                                    <t t-if="group.get('depot_name')">
                                        <div style="font-size: 16px; font-weight: bold; color: #000000; margin-top: 4px; line-height: 1.2;">
                                            <t t-esc="group['depot_name']"/>
                                        </div>
                                    </t>
                                </div>
                                <div style="clear: both;"/>
                            </div>

                            <div>
                                <t t-foreach="page['categories']" t-as="cat">
                                    <div style="font-size: 16px; font-weight: bold; color: #000000; text-transform: uppercase; margin-top: 14px; margin-bottom: 4px; width: 100%;">
                                        <t t-esc="cat['categ_name']"/>
                                    </div>

                                    <div style="width: 100%; font-size: 14px; font-weight: bold; font-style: italic; border-bottom: 2px solid #000000; padding-bottom: 3px; margin-bottom: 3px;">
                                        <div style="float: left; width: 75px; text-align: right; padding-right: 8px;">Quantity</div>
                                        <div style="float: left; width: calc(100% - 150px); text-align: left; padding-left: 10px;">
                                            Product / Box Contents
                                        </div>
                                        <div style="float: right; width: 65px; text-align: right; font-style: normal; font-weight: normal; font-size: 13px;">
                                            Sort
                                        </div>
                                        <div style="clear: both;"/>
                                    </div>

                                    <t t-foreach="cat['products']" t-as="prod">
                                        <div style="width: 100%; font-size: 15px; color: #000000; border-bottom: 1px solid #000000; padding: 4px 0; line-height: 1.35;">
                                            <div style="float: left; width: 75px; text-align: right; padding-right: 8px; font-weight: bold;">
                                                <t t-esc="prod['qty_display']"/>
                                            </div>
                                            <div style="float: left; width: calc(100% - 150px); text-align: left; padding-left: 10px;">
                                                <t t-esc="prod['product_name']"/>
                                            </div>
                                            <div style="float: right; width: 65px; text-align: right; font-weight: normal;">
                                                <t t-esc="prod['sort_str']"/>
                                            </div>
                                            <div style="clear: both;"/>
                                        </div>
                                    </t>

                                </t>

                                <!-- Checked By: only on last page of this batch -->
                                <t t-if="page['is_last_page']">
                                    <div style="margin-top: 25px; margin-bottom: 10px; text-align: right; padding-right: 10px; page-break-inside: avoid;">
                                        <span style="font-size: 14px; font-weight: 500; color: #000000;">Checked By
                                            _____________________
                                        </span>
                                    </div>
                                </t>
                            </div>

                            <!-- Footer: continuous page numbering across the WHOLE driver packing list report -->
                            <div class="footer"
                                 style="font-family: Arial, Helvetica, sans-serif; font-size: 10px; color: #000000; border-top: none; padding: 0; width: 100%;">
                                <div style="position: relative; width: 100%; text-align: center;">
                                    <span style="font-size: 10px; font-weight: normal;">
                                        <t t-esc="page['page_number']"/>
                                    </span>
                                    <span style="position: absolute; right: 0; top: 0; font-size: 10px;">
                                        Printed at:
                                        <t t-esc="printed_at"/>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
            <t t-else="">
                <div style="padding: 20px; font-size: 16px; color: #555;">
                    <div style="font-size: 20px; font-weight: bold; color: #000; margin-bottom: 10px;">
                        Drivers Packing List : Customer
                    </div>
                    <div>No packing list data found for the selected criteria.</div>
                </div>
            </t>
        </t>
    </template>
</odoo>