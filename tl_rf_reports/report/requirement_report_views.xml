<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Paper Format: A4 Landscape for Regal Van -->
    <record id="paperformat_requirement_report" model="report.paperformat">
        <field name="name">Requirement Report A4 Landscape</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">12</field>
        <field name="margin_bottom">18</field>
        <field name="margin_left">12</field>
        <field name="margin_right">12</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    

    <!-- Paper Format: A4 Portrait for Courier -->
    <record id="paperformat_requirement_report_courier" model="report.paperformat">
        <field name="name">Requirement Report A4 Portrait (Courier)</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">12</field>
        <field name="margin_bottom">18</field>
        <field name="margin_left">12</field>
        <field name="margin_right">12</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <!-- Report Action: Regal Van (Landscape) -->
    <record id="action_report_requirement" model="ir.actions.report">
        <field name="name">Requirement Report</field>
        <field name="model">requirement.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">tl_rf_reports.report_requirement</field>
        <field name="report_file">tl_rf_reports.report_requirement</field>
        <field name="print_report_name">('Courier_Requirement_Report_' if object.delivery_channel == 'courier' else 'Requirement_Report_') + (object.delivery_date_from.strftime('%Y%m%d') if object.delivery_date_from else '')</field>
        <field name="paperformat_id" ref="paperformat_requirement_report"/>
        <field name="binding_model_id" eval="False"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Report Action: Courier (Portrait) -->
    <record id="action_report_requirement_courier" model="ir.actions.report">
        <field name="name">Courier Requirement Report</field>
        <field name="model">requirement.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">tl_rf_reports.report_requirement_courier</field>
        <field name="report_file">tl_rf_reports.report_requirement_courier</field>
        <field name="print_report_name">'Courier_Requirement_Report_' + (object.delivery_date_from.strftime('%Y%m%d') if object.delivery_date_from else '')</field>
        <field name="paperformat_id" ref="paperformat_requirement_report_courier"/>
        <field name="binding_model_id" eval="False"/>
        <field name="binding_type">report</field>
    </record>

    <!-- ============================================================== -->
    <!-- 1. COURIER REQUIREMENT REPORT TEMPLATE (Portrait Div-based)    -->
    <!-- ============================================================== -->
    <template id="report_requirement_courier">
        <t t-call="web.html_container">
            <t t-foreach="report_results" t-as="res">
                <t t-if="res.get('categories')">
                    <t t-foreach="res['categories']" t-as="cat_page">

                        <!-- BODY ARTICLE -->
                        <div class="article">
                            <div class="page req-page" style="font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif; color: #000000; padding: 0 5px; background: #ffffff;">

                                <!-- Header: Title on Left, Packing Dates on Right -->
                                <div style="width: 100%; margin-bottom: 6px;">
                                    <div style="float: left; width: 62%;">
                                        <span style="font-size: 22px; font-weight: bold; color: #000000; line-height: 1.2;">
                                            <t t-esc="cat_page['title']"/>
                                        </span>
                                    </div>
                                    <div style="float: right; width: 38%; text-align: left; padding-left: 10px; font-size: 11.5px; font-weight: normal; color: #000000; line-height: 1.35;">
                                        <div>For Packing between <t t-esc="res.get('packing_date_from_str', '')"/> and</div>
                                        <div><t t-esc="res.get('packing_date_to_str', '')"/></div>
                                    </div>
                                    <div style="clear: both;"/>
                                </div>

                                <!-- Products List (Div-based) -->
                                <div class="req-products-container" style="width: 100%; margin-top: 4px;">
                                    <!-- Column Header Row -->
                                    <div class="req-row req-header-row" style="width: 100%; clear: both; overflow: hidden; border-bottom: 2px solid #000000; font-weight: bold; font-size: 15px; padding: 4px 0;">
                                        <div style="float: left; width: 90px; text-align: left;">
                                            Total Kg
                                        </div>
                                        <div style="float: left; width: calc(100% - 90px); text-align: left; padding-left: 10px; box-sizing: border-box;">
                                            Stock Name
                                        </div>
                                        <div style="clear: both;"/>
                                    </div>

                                    <!-- Product Data Rows -->
                                    <t t-foreach="cat_page['products']" t-as="prod">
                                        <div class="req-row req-data-row" style="width: 100%; clear: both; overflow: hidden; border-bottom: 1px solid #000000; font-size: 14.5px; padding: 5px 0;">
                                            <div style="float: left; width: 90px; text-align: left; white-space: nowrap;">
                                                <span style="display: inline-block; width: 45px; text-align: right; font-size: 14.5px;">
                                                    <t t-esc="prod['formatted_total_qty']"/>
                                                </span>
                                                <span style="display: inline-block; width: 25px; text-align: center; font-size: 14.5px; margin-left: 4px;">
                                                    x
                                                </span>
                                            </div>
                                            <div style="float: left; width: calc(100% - 90px); text-align: left; padding-left: 10px; line-height: 1.3; color: #000000; box-sizing: border-box; word-break: break-word;">
                                                <t t-esc="prod['product_name']"/>
                                            </div>
                                            <div style="clear: both;"/>
                                        </div>
                                    </t>
                                </div>

                            </div>
                        </div>

                        <!-- FOOTER (One per article) -->
                        <div class="footer">
                            <div class="o_footer_content req-footer" style="font-family: Arial, Helvetica, sans-serif; font-size: 11px; color: #000000; width: 100%; clear: both; overflow: hidden; padding-top: 4px;">
                                <div class="req-footer-left" style="float: left; width: 50%; text-align: left;">
                                    <t t-esc="res.get('footer_date_str', '')"/>
                                </div>
                                <div class="req-footer-right" style="float: right; width: 50%; text-align: right;">
                                    Page <t t-esc="cat_page_index + 1"/> of <t t-esc="cat_page_size"/>
                                </div>
                            </div>
                        </div>

                    </t>
                </t>

                <!-- Empty State for Courier -->
                <t t-else="">
                    <div class="article">
                        <div class="page req-page" style="font-family: Arial, Helvetica, sans-serif; color: #000000; padding: 20px; background: #ffffff;">
                            <div style="font-size: 18px; font-weight: bold; margin-bottom: 10px;">Courier Requirement Report</div>
                            <div style="font-size: 14px; color: #555555;">
                                No confirmed Courier order lines found for the selected criteria.
                            </div>
                        </div>
                    </div>
                    <div class="footer">
                        <div class="o_footer_content req-footer" style="font-family: Arial, Helvetica, sans-serif; font-size: 11px; color: #000000; width: 100%; clear: both; overflow: hidden; padding-top: 4px;">
                            <div class="req-footer-left" style="float: left; width: 50%; text-align: left;">
                                <t t-esc="res.get('footer_date_str', '')"/>
                            </div>
                            <div class="req-footer-right" style="float: right; width: 50%; text-align: right;">
                                Page 1 of 1
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- ============================================================== -->
    <!-- 2. REGAL VAN REQUIREMENT REPORT TEMPLATE (Landscape 2-Column)   -->
    <!-- ============================================================== -->
    <template id="report_requirement">
        <t t-call="web.html_container">
            <t t-foreach="report_results" t-as="res">
                <t t-if="res.get('categories')">
                    <t t-foreach="res['categories']" t-as="cat_page">

                        <!-- BODY ARTICLE (Each category is a separate article/page) -->
                        <div class="article">
                            <div class="page req-page" style="font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif; color: #000; padding: 0 5px; background: #fff;">

                                <!-- Category Header Banner -->
                                <div class="req-header-banner" style="width: 100%; margin-bottom: 12px;">
                                    <div class="req-title" style="font-size: 15px; font-weight: bold; background-color: #f0f0f0; padding: 6px 10px; border: 1px solid #ddd; border-radius: 2px;">
                                        <t t-esc="cat_page['title']"/>
                                    </div>
                                </div>

                                <!-- 2-Column Side-by-Side Container -->
                                <div class="req-columns-container" style="width: 100%; clear: both;">

                                    <!-- Left Column -->
                                    <div class="req-col req-col-left" style="float: left; width: 48.5%; box-sizing: border-box;">

                                        <!-- Header Row -->
                                        <div class="req-row req-header-row" style="width: 100%; clear: both; overflow: hidden; border-bottom: 2px solid #000; font-weight: bold; font-size: 12px; padding: 3px 0; margin-bottom: 4px;">
                                            <div class="req-col-del-date" style="float: left; width: 26%; text-align: left;">Del Date</div>
                                            <div class="req-col-stock-item" style="float: left; width: 54%; text-align: left;">Stock Item</div>
                                            <div class="req-col-total-qty" style="float: left; width: 20%; text-align: right;">Total Qty</div>
                                        </div>

                                        <!-- Products in Column 1 -->
                                        <t t-foreach="cat_page['col1']" t-as="prod">
                                            <t t-foreach="prod['dates']" t-as="d_entry">
                                                <div class="req-row req-data-row" style="width: 100%; clear: both; overflow: hidden; font-size: 11.5px; padding: 2px 0;">
                                                    <div class="req-col-del-date" style="float: left; width: 26%; text-align: left;">
                                                        <t t-esc="d_entry['delivery_date_str']"/>
                                                    </div>
                                                    <div class="req-col-stock-item" style="float: left; width: 54%; text-align: left; word-break: break-word;">
                                                        <t t-esc="prod['product_name']"/>
                                                    </div>
                                                    <div class="req-col-total-qty" style="float: left; width: 20%; text-align: right;">
                                                        <t t-esc="d_entry['formatted_qty']"/>
                                                    </div>
                                                </div>
                                            </t>

                                            <!-- Subtotal Row -->
                                            <div class="req-row req-subtotal-row" style="width: 100%; clear: both; overflow: hidden; font-size: 11.5px; padding: 1px 0 5px 0;">
                                                <div class="req-col-del-date" style="float: left; width: 26%;">&#160;</div>
                                                <div class="req-col-stock-item" style="float: left; width: 54%; text-align: right; padding-right: 12px; font-weight: bold;">
                                                    Total
                                                </div>
                                                <div class="req-col-total-qty" style="float: left; width: 20%; text-align: right; font-weight: bold;">
                                                    <t t-esc="prod['formatted_total_qty']"/>
                                                </div>
                                            </div>
                                        </t>

                                    </div>

                                    <!-- Right Column -->
                                    <div class="req-col req-col-right" style="float: right; width: 48.5%; box-sizing: border-box;">
                                        <t t-if="cat_page.get('col2')">
                                            <!-- Header Row -->
                                            <div class="req-row req-header-row" style="width: 100%; clear: both; overflow: hidden; border-bottom: 2px solid #000; font-weight: bold; font-size: 12px; padding: 3px 0; margin-bottom: 4px;">
                                                <div class="req-col-del-date" style="float: left; width: 26%; text-align: left;">Del Date</div>
                                                <div class="req-col-stock-item" style="float: left; width: 54%; text-align: left;">Stock Item</div>
                                                <div class="req-col-total-qty" style="float: left; width: 20%; text-align: right;">Total Qty</div>
                                            </div>

                                            <!-- Products in Column 2 -->
                                            <t t-foreach="cat_page['col2']" t-as="prod">
                                                <t t-foreach="prod['dates']" t-as="d_entry">
                                                    <div class="req-row req-data-row" style="width: 100%; clear: both; overflow: hidden; font-size: 11.5px; padding: 2px 0;">
                                                        <div class="req-col-del-date" style="float: left; width: 26%; text-align: left;">
                                                            <t t-esc="d_entry['delivery_date_str']"/>
                                                        </div>
                                                        <div class="req-col-stock-item" style="float: left; width: 54%; text-align: left; word-break: break-word;">
                                                            <t t-esc="prod['product_name']"/>
                                                        </div>
                                                        <div class="req-col-total-qty" style="float: left; width: 20%; text-align: right;">
                                                            <t t-esc="d_entry['formatted_qty']"/>
                                                        </div>
                                                    </div>
                                                </t>

                                                <!-- Subtotal Row -->
                                                <div class="req-row req-subtotal-row" style="width: 100%; clear: both; overflow: hidden; font-size: 11.5px; padding: 1px 0 5px 0;">
                                                    <div class="req-col-del-date" style="float: left; width: 26%;">&#160;</div>
                                                    <div class="req-col-stock-item" style="float: left; width: 54%; text-align: right; padding-right: 12px; font-weight: bold;">
                                                        Total
                                                    </div>
                                                    <div class="req-col-total-qty" style="float: left; width: 20%; text-align: right; font-weight: bold;">
                                                        <t t-esc="prod['formatted_total_qty']"/>
                                                    </div>
                                                </div>
                                            </t>
                                        </t>
                                    </div>

                                </div>

                                <div style="clear: both;"></div>

                            </div>
                        </div>

                        <!-- FOOTER (One per article) -->
                        <div class="footer">
                            <div class="o_footer_content req-footer" style="font-family: Arial, Helvetica, sans-serif; font-size: 11px; color: #444; width: 100%; clear: both; overflow: hidden; border-top: 1px solid #ccc; padding-top: 4px;">
                                <div class="req-footer-left" style="float: left; width: 50%; text-align: left;">
                                    Printed at: <span t-esc="res.get('printed_at_str', '')"/>
                                </div>
                                <div class="req-footer-right" style="float: right; width: 50%; text-align: right;">
                                    Page <t t-esc="cat_page_index + 1"/>
                                </div>
                            </div>
                        </div>

                    </t>
                </t>

                <!-- Empty State for Regal Van -->
                <t t-else="">
                    <div class="article">
                        <div class="page req-page" style="font-family: Arial, Helvetica, sans-serif; color: #000; padding: 20px; background: #fff;">
                            <div style="font-size: 18px; font-weight: bold; margin-bottom: 10px;">Requirement Report</div>
                            <div style="font-size: 14px; color: #555;">
                                No confirmed order lines found for the selected criteria.
                            </div>
                        </div>
                    </div>
                    <div class="footer">
                        <div class="o_footer_content req-footer" style="font-family: Arial, Helvetica, sans-serif; font-size: 11px; color: #444; width: 100%; clear: both; overflow: hidden; border-top: 1px solid #ccc; padding-top: 4px;">
                            <div class="req-footer-left" style="float: left; width: 50%; text-align: left;">
                                Printed at: <span t-esc="res.get('printed_at_str', '')"/>
                            </div>
                            <div class="req-footer-right" style="float: right; width: 50%; text-align: right;">
                                Page 1
                            </div>
                        </div>
                    </div>
                </t>

            </t>
        </t>
    </template>
</odoo>
