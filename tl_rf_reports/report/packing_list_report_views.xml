<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Paper Format with 26mm top margin and 20mm header spacing for repeating header on multi-page batches -->
    <record id="paperformat_packing_list_report" model="report.paperformat">
        <field name="name">Factory Only Packing List A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">26</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">12</field>
        <field name="margin_right">12</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">20</field>
        <field name="dpi">90</field>
    </record>

    <!-- Report Action linked to Custom Paperformat -->
    <record id="action_report_packing_list" model="ir.actions.report">
        <field name="name">Factory Only Packing List</field>
        <field name="model">packing.list.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">tl_rf_reports.report_packing_list</field>
        <field name="report_file">tl_rf_reports.report_packing_list</field>
        <field name="print_report_name">('Packing_List_' + (object.delivery_date_from.strftime('%Y%m%d') if object.delivery_date_from else ''))</field>
        <field name="paperformat_id" ref="paperformat_packing_list_report"/>
        <field name="binding_model_id" eval="False"/>
        <field name="binding_type">report</field>
    </record>

    <!-- QWeb Template: Factory Only Packing List -->
    <template id="report_packing_list">
        <t t-call="web.html_container">
            <style type="text/css">
                .packing-page {
                    font-family: Arial, "Helvetica Neue", Helvetica, sans-serif !important;
                    color: #000000 !important;
                    background: #ffffff !important;
                    width: 100% !important;
                    padding: 0 !important;
                    margin: 0 !important;
                }
                .packing-table {
                    width: 100% !important;
                    min-width: 100% !important;
                    border-collapse: collapse !important;
                    border: none !important;
                    margin: 0 0 4px 0 !important;
                    padding: 0 !important;
                }
                .packing-table thead tr {
                    border: none !important;
                    border-bottom: 1.5px solid #000000 !important;
                }
                .packing-table thead th {
                    border: none !important;
                    border-bottom: 1.5px solid #000000 !important;
                    padding: 3px 0 !important;
                }
                .packing-table tbody tr {
                    border: none !important;
                    border-bottom: 1px solid #000000 !important;
                }
                .packing-table tbody td {
                    border: none !important;
                    border-bottom: 1px solid #000000 !important;
                    padding: 3.5px 0 !important;
                }
            </style>

            <t t-if="batch_groups">
                <t t-foreach="batch_groups" t-as="group">
                    <div class="article" t-attf-style="#{'page-break-before: always;' if not group_first else ''}">
                        <!-- Top Header: Fixed on every page of this batch -->
                        <div class="header" style="font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif; color: #000000; width: 100%; border: none !important; padding: 0; margin: 0;">
                            <div style="width: 100%; border: none !important;">
                                <div style="float: left; width: 60%; border: none !important;">
                                    <div style="font-size: 20px; font-weight: bold; color: #000000; line-height: 1.2;">
                                        Factory Only Packing List
                                    </div>
                                    <div style="font-size: 16px; font-weight: bold; color: #000000; margin-top: 4px; line-height: 1.2;">
                                        <span style="display: inline-block; min-width: 75px;"><t t-esc="group['batch_code']"/></span>
                                        <span style="margin-left: 20px;"><t t-esc="group['batch_name']"/></span>
                                    </div>
                                </div>
                                <div style="float: right; width: 40%; text-align: right; border: none !important;">
                                    <div style="font-size: 15px; font-weight: bold; color: #000000; line-height: 1.2;">
                                        <span>Delivery On: </span><t t-esc="group['delivery_date']"/>
                                    </div>
                                    <t t-if="group.get('depot_name')">
                                        <div style="font-size: 15px; font-weight: bold; color: #000000; margin-top: 4px; line-height: 1.2;">
                                            <t t-esc="group['depot_name']"/>
                                        </div>
                                    </t>
                                </div>
                                <div style="clear: both;"/>
                            </div>
                        </div>

                        <!-- Page Body Content -->
                        <div class="page packing-page">
                            <!-- Categories and Products Loop -->
                            <t t-foreach="group['categories']" t-as="cat">
                                <!-- Category Title in bold uppercase -->
                                <div style="font-size: 15px; font-weight: bold; color: #000000; text-transform: uppercase; margin-top: 14px; margin-bottom: 2px; width: 100%;">
                                    <t t-esc="cat['categ_name']"/>
                                </div>

                                <!-- Full Width Product Table with ONLY horizontal line after each product -->
                                <table class="packing-table" style="width: 100% !important; min-width: 100% !important; border-collapse: collapse !important; border: none !important;">
                                    <thead>
                                        <tr style="border: none !important; border-bottom: 1.5px solid #000000 !important;">
                                            <th style="width: 70px; text-align: center; vertical-align: middle; font-size: 13px; font-weight: bold; font-style: italic; border: none !important; border-bottom: 1.5px solid #000000 !important; padding: 3px 0 !important;">
                                                Quantity
                                            </th>
                                            <th style="text-align: left; vertical-align: middle; font-size: 13px; font-weight: bold; font-style: italic; border: none !important; border-bottom: 1.5px solid #000000 !important; padding: 3px 10px !important;">
                                                Product / Box Contents
                                            </th>
                                            <th style="width: 60px; text-align: right; vertical-align: middle; font-size: 12px; font-weight: normal; border: none !important; border-bottom: 1.5px solid #000000 !important; padding: 3px 0 !important;">
                                                Sort
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="cat['products']" t-as="prod">
                                            <tr style="border: none !important; border-bottom: 1px solid #000000 !important;">
                                                <td style="width: 70px; text-align: center; vertical-align: middle; font-size: 13px; font-weight: bold; white-space: nowrap; border: none !important; border-bottom: 1px solid #000000 !important; padding: 3.5px 0 !important;">
                                                    <t t-esc="prod['qty_display']"/>
                                                </td>
                                                <td style="text-align: left; vertical-align: middle; font-size: 13px; font-weight: normal; line-height: 1.3; color: #000000; border: none !important; border-bottom: 1px solid #000000 !important; padding: 3.5px 10px !important;">
                                                    <t t-esc="prod['product_name']"/>
                                                </td>
                                                <td style="width: 60px; text-align: right; vertical-align: middle; font-size: 13px; font-weight: normal; color: #000000; border: none !important; border-bottom: 1px solid #000000 !important; padding: 3.5px 0 !important;">
                                                    <t t-esc="prod['sort_str']"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>

                                <!-- Category Box Count directly below each Category table -->
                                <div style="margin-top: 1px; margin-bottom: 12px;">
                                    <div style="border-top: 1.5px solid #000000; width: 100px; text-align: center; padding-top: 2px; font-size: 13px; font-weight: bold; color: #000000;">
                                        <t t-esc="cat['total_boxes']"/> Boxes
                                    </div>
                                </div>
                            </t>

                            <!-- End of Batch: Checked By signature on bottom right -->
                            <div style="margin-top: 20px; margin-bottom: 10px; text-align: right; padding-right: 10px; page-break-inside: avoid;">
                                <span style="font-size: 13px; color: #000000;">Checked By _____________________</span>
                            </div>
                        </div>

                        <!-- Footer: Page Number Centered (Continuous across all pages), Printed at on Right -->
                        <div class="footer" style="font-family: Arial, Helvetica, sans-serif; font-size: 10px; color: #000000; border-top: none; padding: 0; width: 100%;">
                            <div style="position: relative; width: 100%; text-align: center;">
                                <span class="page" style="font-size: 10px; font-weight: normal;"/>
                                <span style="position: absolute; right: 0; top: 0; font-size: 10px;">
                                    Printed at: <t t-esc="printed_at"/>
                                </span>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
            <t t-else="">
                    <div style="padding: 20px; font-size: 16px; color: #555;">
                        <div style="font-size: 20px; font-weight: bold; color: #000; margin-bottom: 10px;">
                                Factory Only Packing List
                        </div>
                 <div>No packing list data found for the selected criteria.</div>
                    </div>
                </t>
                <!-- Footer: Continuous Sequential Page Numbering Centered, Printed at on Right -->
                <div class="footer" style="font-family: Arial, Helvetica, sans-serif; font-size: 10px; color: #000000; border-top: none; padding: 0; width: 100%;">
                    <div style="position: relative; width: 100%; text-align: center;">
                        <span class="page" style="font-size: 10px; font-weight: normal;"/>
                        <span style="position: absolute; right: 0; top: 0; font-size: 10px;">
                            Printed at: <t t-esc="printed_at"/>
                        </span>
                    </div>
                </div>

        </t>
    </template>
</odoo>
