<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Driver Copy: Delivery Order > Print > Driver Copy.
         The PDF itself is built with ReportLab (report/driver_copy_report.py,
         routed in models/ir_actions_report.py); the template below is only a
         placeholder for Odoo's HTML fallback. -->
    <record id="action_report_driver_copy" model="ir.actions.report">
        <field name="name">Driver Copy</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">tl_rf_reports.report_driver_copy</field>
        <field name="report_file">tl_rf_reports.report_driver_copy</field>
        <field name="print_report_name">'Driver Copy - %s' % (object.sale_id.name or object.name)</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Customer Copy: same document without tel/mob, signatures and total. -->
    <record id="action_report_customer_copy" model="ir.actions.report">
        <field name="name">Customer Copy</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">tl_rf_reports.report_customer_copy</field>
        <field name="report_file">tl_rf_reports.report_customer_copy</field>
        <field name="print_report_name">'Customer Copy - %s' % (object.sale_id.name or object.name)</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_customer_copy">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <div class="page"><p>Customer Copy - <t t-esc="o.name"/></p></div>
            </t>
        </t>
    </template>

    <template id="report_driver_copy">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <div class="page"><p>Driver Copy - <t t-esc="o.name"/></p></div>
            </t>
        </t>
    </template>
</odoo>
