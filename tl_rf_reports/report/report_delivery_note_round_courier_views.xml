<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Paper Format: A4 portrait, 10mm top, 18mm bottom (room for the repeating footer), 9mm sides -->
    <record id="paperformat_delivery_note_round_courier_report" model="report.paperformat">
        <field name="name">Delivery Note Round Report (Courier) A4</field>
        <field name="default" eval="False" />
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">18</field>
        <field name="margin_left">9</field>
        <field name="margin_right">9</field>
        <field name="header_line" eval="False" />
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <!-- Report Action -->
    <record id="action_report_delivery_note_round_courier" model="ir.actions.report">
        <field name="name">Delivery Note Round Report (Courier)</field>
        <field name="model">delivery.note.round.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">tl_rf_reports.report_delivery_note_round_courier</field>
        <field name="report_file">tl_rf_reports.report_delivery_note_round_courier</field>
        <field name="print_report_name">('Delivery_Note_Round_Courier_' +
            (object.delivery_date_from.strftime('%Y%m%d') if object.delivery_date_from else ''))</field>
        <field name="paperformat_id" ref="paperformat_delivery_note_round_courier_report" />
        <field name="binding_model_id" eval="False" />
        <field name="binding_type">report</field>
    </record>

    <!--
        QWeb Template - redesigned to match the "Customer Delivery Note" PDF
        mockup (RegalFish logo + title, Customer ID, bold name, Deliver To
        address block, items grouped by category with rule lines, repeating
        footer disclaimer). One order per page.
    -->
    <template id="report_delivery_note_round_courier">
        <t t-call="web.html_container">
            <t t-if="courier_orders">
                <t t-foreach="courier_orders" t-as="co">
                    <div class="article"
                        t-attf-style="position: relative; min-height: 269mm; box-sizing: border-box; #{'page-break-before: always;' if not co_first else ''}">
                        <div
                            style="font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif; color: #000000; width: 100%; padding: 0; margin: 0; box-sizing: border-box;">

                            <!-- ==================== LOGO + TITLE ==================== -->
                            <div style="width: 100%; margin-bottom: 14px;">
                                <div style="float: left; width: 22%;">
                                    <img t-if="co.get('company_logo_uri') or company_logo_uri or company.logo"
                                        t-att-src="co.get('company_logo_uri') or company_logo_uri or image_data_uri(company.logo)"
                                        style="max-height: 50px; max-width: 100%;" />
                                </div>
                                <div
                                    style="float: left; width: 78%; font-size: 18px; padding-top: 12px; padding-left: 24px; box-sizing: border-box;">
                                    Customer Delivery Note: For Delivery
                                    <t t-esc="co['delivery_date']" />
                                </div>
                                <div style="clear: both;" />
                            </div>

                            <!-- ==================== CUSTOMER ID ==================== -->
                            <div style="width: 100%; font-size: 13px; margin-bottom: 2px;">
                                Customer ID&#160;&#160;<span
                                    style="font-weight: bold;"><t t-esc="co['customer_id']" /></span>
                            </div>

                            <!-- ==================== NAME + DELIVER TO ==================== -->
                            <div style="width: 100%; margin-bottom: 8px;">
                                <div
                                    style="float: left; width: 42%; font-size: 16px; font-weight: bold;">
                                    <t t-esc="co['customer_name']" />
                                </div>
                                <div style="float: left; width: 58%;">
                                    <div style="width: 100%;">
                                        <span
                                            style="float: left; width: 26%; font-size: 13px; color: #333333; white-space: nowrap;">Deliver
                                            To:</span>
                                        <span
                                            style="float: left; width: 74%; font-size: 15px; font-weight: bold;">
                                            <t t-esc="co['address_line1']" />
                                        </span>
                                        <div style="clear: both;" />
                                    </div>
                                    <div style="width: 100%;">
                                        <span style="float: left; width: 26%;">&#160;</span>
                                        <span
                                            style="float: left; width: 74%; font-size: 15px; font-weight: bold;">
                                            <t t-esc="co['address_line2']" />
                                        </span>
                                        <div style="clear: both;" />
                                    </div>
                                </div>
                                <div style="clear: both;" />
                            </div>

                            <div style="border-top: 1px solid #000000; width: 100%;" />

                            <!-- ==================== CATEGORIES / ITEMS ==================== -->
                            <t t-foreach="co['categories']" t-as="cat">
                                <div
                                    style="font-size: 13.5px; font-weight: bold; margin-top: 6px; margin-bottom: 2px;">
                                    <t t-esc="cat['name']" />
                                </div>
                                <div style="border-top: 1px solid #000000; width: 100%;" />
                                <t t-foreach="cat['lines']" t-as="line">
                                    <div style="width: 100%; padding: 3px 0; box-sizing: border-box;">
                                        <span
                                            style="float: left; width: 6%; font-size: 13.5px;"><t
                                                t-esc="line['qty']" /></span>
                                        <span style="float: left; width: 6%; font-size: 13.5px;">X</span>
                                        <span style="float: left; width: 88%; font-size: 13.5px;">
                                            <t t-esc="line['product_name']" />
                                            <t t-if="line['extra_note']">
                                                <t t-esc="' ' + line['extra_note']" />
                                            </t>
                                        </span>
                                        <div style="clear: both;" />
                                    </div>
                                </t>
                                <div style="border-top: 1px solid #000000; width: 100%;" />
                            </t>

                            <!-- ==================== FOOTER ==================== -->
<!--                            <div-->
<!--                                style="position: absolute; bottom: 0; left: 0; right: 0; text-align: center; font-size: 9.5px; line-height: 1.4; color: #333333;">-->
<!--                                The goods received should arrive with you in perfect condition having-->
<!--                                been held at optimum temperature. If for any reason you are unhappy-->
<!--                                with the goods or you believe they have not been delivered as expected-->
<!--                                then please don't hesitate to contact one of our customer service team-->
<!--                                on-->
<!--                                <t t-esc="company.phone or ''" /> or by email to-->
<!--                                <t t-esc="company.email or ''" /> and someone will be happy to assist-->
<!--                                with your query.-->
<!--                            </div>-->
                        </div>
                    </div>
                    <div class="footer" style="font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif; font-size: 9.5px; line-height: 1.4; color: #333333; width: 100%; text-align: center; padding: 0; margin: 0; border: none;">
                        <div style="width: 100%; text-align: center;">
                            The goods received should arrive with you in perfect condition having been held at optimum temperature. If for any reason you are unhappy with the goods or you believe they have not been delivered as expected then please don't hesitate to contact one of our customer service team on <t t-esc="company.phone or ''"/> or by email to <t t-esc="company.email or ''"/> and someone will be happy to assist with your query.
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>