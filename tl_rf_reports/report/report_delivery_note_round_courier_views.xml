<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Paper Format: A4 portrait, 10mm top, 18mm bottom, 9mm sides -->
    <record id="paperformat_delivery_note_round_courier_report" model="report.paperformat">
        <field name="name">Delivery Note Round Report (Courier) A4</field>
        <field name="default" eval="False" />
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">18</field>
        <field name="margin_left">9</field>
        <field name="margin_right">9</field>
        <field name="header_line" eval="False" />
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <!-- Report Action -->
    <record id="action_report_delivery_note_round_courier" model="ir.actions.report">
        <field name="name">Delivery Note Round Report (Courier)</field>
        <field name="model">delivery.note.round.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">tl_rf_reports.report_delivery_note_round_courier</field>
        <field name="report_file">tl_rf_reports.report_delivery_note_round_courier</field>
        <field name="print_report_name">('Delivery_Note_Round_Courier_' + (object.delivery_date_from.strftime('%Y%m%d') if object.delivery_date_from else ''))</field>
        <field name="paperformat_id" ref="paperformat_delivery_note_round_courier_report" />
        <field name="binding_model_id" eval="False" />
        <field name="binding_type">report</field>
    </record>

    <!-- QWeb Template -->
    <template id="report_delivery_note_round_courier">
        <t t-call="web.html_container">
            <t t-if="courier_orders">
                <t t-foreach="courier_orders" t-as="co">
                    <div class="article" style="page-break-after: always; font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif; color: #000000; width: 100%; padding: 0; margin: 0; box-sizing: border-box;">
                        
                        <!-- Header / Logo -->
                        <table style="width: 100%; margin-bottom: 14px; border-collapse: collapse;">
                            <tr>
                                <td style="width: 22%; vertical-align: middle;">
                                    <img t-if="co.get('company_logo_uri') or company_logo_uri or company.logo"
                                         t-att-src="co.get('company_logo_uri') or company_logo_uri or image_data_uri(company.logo)"
                                         style="max-height: 50px; max-width: 100%;" />
                                </td>
                                <td style="width: 78%; font-size: 18px; vertical-align: middle; padding-left: 15px;">
                                    Customer Delivery Note: For Delivery <t t-esc="co['delivery_date']" />
                                </td>
                            </tr>
                        </table>

