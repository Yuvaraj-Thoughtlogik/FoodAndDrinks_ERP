<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="custom_purchase_order_document">
        <t t-call="web.basic_layout">
            <t t-foreach="docs" t-as="doc">
                <div class="tl-po"
                     style="font-family: Arial, Helvetica, sans-serif; font-size: 11px; color: #000000; padding: 0 10px;">

                    <!-- ============ Letterhead: logo + company block ============ -->
                    <div style="overflow:hidden;">
                        <div style="float:left; width:50%;">
                            <img t-if="doc.company_id.logo" t-att-src="image_data_uri(doc.company_id.logo)"
                                 style="max-height: 55px; max-width: 220px;"/>
                        </div>
                        <div style="float:right; width:50%; text-align:right; font-size:10.5px; line-height:1.4;">
                            <strong t-field="doc.company_id.name"/>
                            <br/>
                            <span t-field="doc.company_id.street"/>
                            <br/>
                            <span t-if="doc.company_id.street2" t-field="doc.company_id.street2"/>
                            <t t-if="doc.company_id.street2">
                                <br/>
                            </t>
                            <span t-field="doc.company_id.city"/>
                            <br/>
                            <span t-if="doc.company_id.state_id" t-field="doc.company_id.state_id.name"/>
                            <br t-if="doc.company_id.state_id"/>
                            <span t-field="doc.company_id.zip"/>
                            <span t-if="doc.company_id.country_id">
                                <span t-field="doc.company_id.country_id.code"/>
                            </span>
                            <br/>
                            <br/>
                            <span t-if="doc.company_id.vat">VAT Reg. No.
                                <span t-field="doc.company_id.vat"/>
                                <br/>
                            </span>
                            <span t-if="doc.company_id.phone">Phone
                                <span t-field="doc.company_id.phone"/>
                            </span>
                        </div>
                    </div>
                    <div style="clear:both;"/>

                    <!-- ============ Title ============ -->
                    <h3 style="text-align:center; font-size:14px; font-weight:bold; margin: 18px 0 32px 0;">PURCHASE
                        ORDER
                    </h3>

                    <!-- ============ Vendor / Delivery address blocks ============ -->
                    <div style="overflow:hidden; margin-bottom: 14px;">
                        <div style="float:left; width:48%; font-size:11px; line-height:1.4;">
                            <span t-field="doc.partner_id"
                                  t-options='{"widget": "contact", "fields": ["name", "address"], "no_marker": True}'/>
                        </div>
                        <div style="float:right; width:48%; font-size:11px; line-height:1.4;">
                            Please deliver to:
                            <br/>
                            <t t-if="doc.picking_type_id.warehouse_id.partner_id">
                                <span t-field="doc.picking_type_id.warehouse_id.partner_id"
                                      t-options='{"widget": "contact", "fields": ["name", "address"], "no_marker": True}'/>
                            </t>
                            <t t-else="">
                                <span t-field="doc.company_id.partner_id"
                                      t-options='{"widget": "contact", "fields": ["name", "address"], "no_marker": True}'/>
                            </t>
                        </div>
                    </div>
                    <div style="clear:both;"/>

                    <!-- ============ Header info strip ============ -->
                    <div style="padding-bottom:3px; margin-bottom:2px; overflow:hidden;">
                        <div style="float:left; width:16%; box-sizing:border-box; padding-right:6px; font-size:10px; font-weight:bold;">
                            Your Ref
                        </div>
                        <div style="float:left; width:14%; box-sizing:border-box; padding-right:6px; font-size:10px; font-weight:bold;">
                            Account
                        </div>
                        <div style="float:left; width:14%; box-sizing:border-box; padding-right:6px; font-size:10px; font-weight:bold;">
                            Our Ref
                        </div>
                        <div style="float:left; width:11%; box-sizing:border-box; padding-right:6px; font-size:10px; font-weight:bold;">
                            Delivery
                        </div>
                        <div style="float:left; width:11%; box-sizing:border-box; padding-right:6px; font-size:10px; font-weight:bold;">
                            Type
                        </div>
                        <div style="float:left; width:17%; box-sizing:border-box; padding-right:6px; font-size:10px; font-weight:bold;">
                            Date
                        </div>
                        <div style="float:left; width:17%; box-sizing:border-box; font-size:10px; font-weight:bold;">
                            Required
                        </div>
                    </div>
                    <div style="clear:both;"/>
                    <div style="margin-bottom: 10px; overflow:hidden;">
                        <div style="float:left; width:16%; box-sizing:border-box; padding-right:6px; font-size:11px;">
                            <span t-if="doc.partner_ref" t-field="doc.partner_ref"/>&#160;
                        </div>
                        <!-- TODO: confirm source field for "Account" once user confirms -->
                        <div style="float:left; width:14%; box-sizing:border-box; padding-right:6px; font-size:11px;">
                            <span t-if="doc.partner_id.ref" t-field="doc.partner_id.ref"/>&#160;
                        </div>
                        <!-- TODO: confirm source field for "Our Ref" once user confirms -->
                        <div style="float:left; width:14%; box-sizing:border-box; padding-right:6px; font-size:11px;">
                            <span t-field="doc.name"/>&#160;
                        </div>
                        <!-- TODO: confirm source field for "Delivery" once user confirms -->
                        <div style="float:left; width:11%; box-sizing:border-box; padding-right:6px; font-size:11px;">
                            <span t-if="doc.incoterm_id" t-field="doc.incoterm_id.name"/>&#160;
                        </div>
                        <!-- TODO: confirm source field for "Type" once user confirms -->
                        <div style="float:left; width:11%; box-sizing:border-box; padding-right:6px; font-size:11px;">
                            <span t-if="doc.partner_ref" t-field="doc.partner_ref"/>&#160;
                        </div>
                        <div style="float:left; width:17%; box-sizing:border-box; padding-right:6px; font-size:11px;">
                            <span t-if="doc.date_approve" t-field="doc.date_approve"
                                  t-options='{"widget": "date", "format": "dd/MM/yyyy"}'/>&#160;
                        </div>
                        <div style="float:left; width:17%; box-sizing:border-box; font-size:11px;">
                            <span t-if="doc.date_planned" t-field="doc.date_planned"
                                  t-options='{"widget": "date", "format": "dd/MM/yyyy"}'/>&#160;
                        </div>
                    </div>
                    <div style="clear:both;"/>

                    <!-- ============ Order lines header ============ -->
                    <div style="padding-bottom:3px; margin-bottom:4px; overflow:hidden;">
                        <div style="float:left; width:40%; font-size:10px; font-weight:bold;">Description</div>
                        <div style="float:left; width:12%; text-align:right; font-size:10px; font-weight:bold;">
                            Quantity
                        </div>
                        <div style="float:left; width:14%; text-align:center; font-size:10px; font-weight:bold;">
                            Required
                        </div>
                        <div style="float:left; width:14%; text-align:right; font-size:10px; font-weight:bold;">Price
                            £
                        </div>
                        <div style="float:left; width:20%; text-align:right; font-size:10px; font-weight:bold;">Value
                            £
                        </div>
                    </div>
                    <div style="clear:both;"/>

                    <!-- ============ Order lines ============ -->
                    <t t-foreach="doc.order_line" t-as="line">
                        <div t-if="line.display_type == 'line_section'" style="font-weight:bold; padding:6px 0 2px 0;">
                            <span t-field="line.name"/>
                        </div>
                        <div t-elif="line.display_type == 'line_note'" style="font-style:italic; padding:2px 0;">
                            <span t-field="line.name"/>
                        </div>
                        <t t-elif="not line.display_type">
                            <div style="margin-bottom:6px; overflow:hidden;">
                                <div style="float:left; width:40%; font-size:11px;">
                                    <span t-if="line.product_id.default_code" t-field="line.product_id.default_code"/>
                                    <br
                                            t-if="line.product_id.default_code"/>
                                    <span t-field="line.product_id.name"/>
                                </div>
                                <div style="float:left; width:12%; text-align:right; font-size:11px;">
                                    <span t-esc="'{:,.2f}'.format(line.product_qty)"/>
                                </div>
                                <div style="float:left; width:14%; text-align:center; font-size:11px;">
                                    <span t-if="line.date_planned" t-field="line.date_planned"
                                          t-options='{"widget": "date", "format": "dd/MM/yyyy"}'/>
                                </div>
                                <div style="float:left; width:14%; text-align:right; font-size:11px;">
                                    <span t-esc="'{:,.2f}'.format(line.price_unit)"/>
                                </div>
                                <div style="float:left; width:20%; text-align:right; font-size:11px;">
                                    <span t-esc="'{:,.2f}'.format(line.price_subtotal)"/>
                                </div>
                            </div>
                            <div style="clear:both;"/>
                        </t>
                    </t>
                    <div style="min-height: 320px;"/>

                    <!-- ============ Totals ============ -->
                    <div style="margin-top: 18px; overflow:hidden;">
                        <div style="float:right; width:40%;">
                            <div style="overflow:hidden; font-size:11px; padding:2px 0;">
                                <div style="float:left;">Net £</div>
                                <div style="float:right;">
                                    <span t-esc="'{:,.2f}'.format(doc.amount_untaxed)"/>
                                </div>
                            </div>
                            <div style="clear:both;"/>
                            <div style="overflow:hidden; font-size:11px; padding:2px 0;">
                                <div style="float:left;">VAT £</div>
                                <div style="float:right;">
                                    <span t-esc="'{:,.2f}'.format(doc.amount_tax)"/>
                                </div>
                            </div>
                            <div style="clear:both;"/>
                            <div style="overflow:hidden; font-size:11px; font-weight:bold; padding-top:4px;">
                                <div style="float:left;">Total £</div>
                                <div style="float:right;">
                                    <span t-esc="'{:,.2f}'.format(doc.amount_total)"/>
                                </div>
                            </div>
                            <div style="clear:both;"/>
                        </div>
                    </div>
                    <div style="clear:both;"/>

                </div>
                <p t-if="not doc_last" style="page-break-after: always;"/>
            </t>
        </t>
    </template>

</odoo>