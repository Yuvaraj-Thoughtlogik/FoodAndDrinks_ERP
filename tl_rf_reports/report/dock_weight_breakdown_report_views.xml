<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Paper Format with tight 15mm margins to eliminate large top gap -->
    <record id="paperformat_dock_weight_report" model="report.paperformat">
        <field name="name">Dock Weight Report A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">15</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">15</field>
        <field name="margin_right">15</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <!-- Report Action linked to Custom Paperformat -->
    <record id="action_report_dock_weight_breakdown" model="ir.actions.report">
        <field name="name">Dock Weight Breakdown Report</field>
        <field name="model">batch.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">tl_rf_reports.report_dock_weight_breakdown</field>
        <field name="report_file">tl_rf_reports.report_dock_weight_breakdown</field>
        <field name="print_report_name">('Courier_Dock_Weight_' if object.delivery_channel == 'courier' else 'Dock_Weight_Breakdown_') + (object.delivery_date_from.strftime('%Y%m%d') if object.delivery_date_from else '')</field>
        <field name="paperformat_id" ref="paperformat_dock_weight_report"/>
        <field name="binding_model_id" eval="False"/>
        <field name="binding_type">report</field>
    </record>

    <!-- QWeb Template: Supports both Regal Van Delivery and Courier Delivery -->
    <template id="report_dock_weight_breakdown">
        <t t-call="web.html_container">
            <t t-foreach="report_results" t-as="res">
                <t t-call="web.basic_layout">
                    <!-- Courier Delivery Report Layout -->
                    <t t-if="res.get('delivery_channel') == 'courier'">
                        <t t-if="res.get('categories')">
                            <t t-foreach="res['categories']" t-as="cat_page">
                                <div class="page" t-attf-style="font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif; color: #000; padding: 10px 15px; background: #fff; #{'page-break-before: always;' if not cat_page_first else ''}">
                                    <!-- Courier Report Header -->
                                    <div style="margin-bottom: 6px;">
                                        <span style="font-size: 22px; font-weight: bold; color: #000; line-height: 1.2;">
                                            Courier Dock Weight Report
                                        </span>
                                    </div>

                                    <!-- Delivery Date -->
                                    <div style="margin-bottom: 20px; font-size: 15px; font-weight: bold; color: #111;">
                                        <span>Delivery Date: </span>
                                        <t t-esc="res['formatted_date']"/>
                                    </div>

                                    <!-- Category Title -->
                                    <div style="font-size: 24px; font-weight: 800; color: #000; margin-bottom: 15px; border-bottom: 2px solid #000; padding-bottom: 4px;">
                                        <span>Product Category: </span>
                                        <span style="text-transform: capitalize;"><t t-esc="cat_page['categ_name']"/></span>
                                    </div>

                                    <!-- Table Header -->
                                    <table style="width: 100%; max-width: 750px; border-collapse: collapse; color: #000; margin-top: 5px; border: none !important;">
                                        <thead>
                                            <tr style="border: none !important; border-bottom: 2px solid #000 !important;">
                                                <th style="width: 130px; text-align: left; vertical-align: middle; padding: 6px 12px 6px 0; font-size: 15px; font-weight: bold; border: none !important; border-bottom: 2px solid #000 !important;">
                                                    Weight (Kg)
                                                </th>
                                                <th style="text-align: left; vertical-align: middle; padding: 6px 0; font-size: 15px; font-weight: bold; border: none !important; border-bottom: 2px solid #000 !important;">
                                                    Product
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="cat_page['product_list']" t-as="prod">
                                                <tr style="border: none !important; border-bottom: 1px solid #333 !important;">
                                                    <td style="width: 130px; text-align: left; vertical-align: top; padding: 6px 12px 6px 0; font-size: 15px; font-weight: bold; white-space: nowrap; border: none !important; border-bottom: 1px solid #333 !important;">
                                                        <t t-esc="'%.2f' % prod['total_weight']"/>
                                                    </td>
                                                    <td style="vertical-align: top; padding: 6px 0; font-size: 15px; font-weight: 500; line-height: 1.4; color: #000; border: none !important; border-bottom: 1px solid #333 !important;">
                                                        <t t-esc="prod['product_name']"/>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </t>
                        </t>
                        <t t-else="">
                            <div class="page" style="font-family: Arial, Helvetica, sans-serif; color: #000; padding: 20px; background: #fff;">
                                <div style="font-size: 20px; font-weight: bold; margin-bottom: 10px;">
                                    Courier Dock Weight Report
                                </div>
                                <div style="margin-top: 10px; font-size: 16px; color: #555;">
                                    No Courier Delivery orders found for the selected criteria.
                                </div>
                            </div>
                        </t>
                    </t>

                    <!-- Regal Van Delivery Report Layout (Batch-based) -->
                    <t t-else="">
                        <t t-if="res.get('pages')">
                            <t t-foreach="res['pages']" t-as="combo_page">
                                <div class="page" t-attf-style="font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif; color: #000; padding: 10px 15px; background: #fff; #{'page-break-before: always;' if not combo_page_first else ''}">
                                    <!-- Report Title -->
                                    <div style="margin-bottom: 4px;">
                                        <span style="font-size: 20px; font-weight: bold; color: #000; line-height: 1.2;">
                                            Dock Weight Breakdown Report
                                        </span>
                                    </div>

                                    <!-- Delivery Date -->
                                    <div style="margin-bottom: 24px;">
                                        <span style="font-size: 15px; font-weight: bold; color: #111;">
                                            <t t-esc="res['formatted_date']"/>
                                        </span>
                                    </div>

                                    <!-- Depot and Category Title (e.g. Grimsby FRESH) -->
                                    <div style="font-size: 32px; font-weight: 900; color: #000; margin-bottom: 22px; letter-spacing: 0.5px;">
                                        <span style="display: inline-block; min-width: 170px; margin-right: 35px;">
                                            <t t-esc="combo_page['depot_name']"/>
                                        </span>
                                        <span>
                                            <t t-esc="combo_page['categ_name']"/>
                                        </span>
                                    </div>

                                    <!-- Column Sub-Header -->
                                    <div style="font-size: 14px; font-style: italic; font-weight: bold; color: #000; margin-bottom: 12px; padding-left: 2px;">
                                        Sold Weight (Kg)
                                    </div>

                                    <!-- Product Weight Breakdown List -->
                                    <table style="width: 100%; max-width: 750px; border-collapse: collapse; color: #000; border: none !important;">
                                        <tbody style="border: none !important;">
                                            <t t-foreach="combo_page['product_list']" t-as="prod">
                                                <tr style="border: none !important;">
                                                    <td style="width: 80px; text-align: right; vertical-align: top; padding: 5px 28px 5px 0; font-size: 15px; font-weight: bold; white-space: nowrap; border: none !important;">
                                                        <t t-esc="'%.2f' % prod['total_weight']"/>
                                                    </td>
                                                    <td style="vertical-align: top; padding: 5px 0; font-size: 15px; font-weight: 500; line-height: 1.4; color: #000; border: none !important;">
                                                        <t t-esc="prod['product_name']"/>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </t>
                        </t>
                        <t t-else="">
                            <div class="page" style="font-family: Arial, Helvetica, sans-serif; color: #000; padding: 20px; background: #fff;">
                                <div style="margin-top: 20px; font-size: 16px; color: #555;">
                                    No orders or products found for the selected criteria.
                                </div>
                            </div>
                        </t>
                    </t>
                </t>
            </t>
        </t>
    </template>
</odoo>
