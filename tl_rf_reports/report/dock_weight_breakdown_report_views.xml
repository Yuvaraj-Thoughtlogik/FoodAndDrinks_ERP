<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Paper Format: 15mm top/left/right, 22mm bottom reserved for the footer -->
    <record id="paperformat_dock_weight_report" model="report.paperformat">
        <field name="name">Dock Weight Report A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">15</field>
        <field name="margin_bottom">22</field>
        <field name="margin_left">15</field>
        <field name="margin_right">15</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_dock_weight_breakdown" model="ir.actions.report">
        <field name="name">Dock Weight Breakdown Report</field>
        <field name="model">batch.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">tl_rf_reports.report_dock_weight_breakdown</field>
        <field name="report_file">tl_rf_reports.report_dock_weight_breakdown</field>
        <field name="print_report_name">('Courier_Dock_Weight_' if object.delivery_channel == 'courier' else 'Dock_Weight_Breakdown_') + (object.delivery_date_from.strftime('%Y%m%d') if object.delivery_date_from else '')</field>
        <field name="paperformat_id" ref="paperformat_dock_weight_report"/>
        <field name="binding_model_id" eval="False"/>
        <field name="binding_type">report</field>
    </record>

    <!--
        IMPORTANT (Odoo 17/18/19 report mechanics):
        * web.basic_layout already calls web.html_container, so it must NOT be nested
          inside another web.html_container. We emit the "article" div ourselves instead.
        * Every div.footer is extracted from the body and stacked into a single
          footer-html document; minimal_layout's subst() then shows
          footers.children[<body index>]. Therefore there must be EXACTLY ONE
          div.footer per div.article, in the same order - otherwise the footer
          container is cleared and nothing is printed.
    -->
    <template id="report_dock_weight_breakdown">
        <t t-call="web.html_container">
            <t t-foreach="report_results" t-as="res">

                <!-- ============ COURIER DELIVERY ============ -->
                <t t-if="res.get('delivery_channel') == 'courier'">
                    <t t-if="res.get('categories')">
                        <t t-foreach="res['categories']" t-as="cat_page">

                            <!-- BODY -->
                            <div class="article">
                                <div class="page" style="font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif; color: #000; padding: 0 10px; background: #fff;">
                                    <table style="width: 100%; border-collapse: collapse; border: none !important; margin-bottom: 2px;">
                                        <tr style="border: none !important;">
                                            <td style="width: 58%; vertical-align: bottom; text-align: left; padding: 0; border: none !important;">
                                                <span style="font-size: 26px; font-weight: bold; color: #000; line-height: 1.2;">
                                                    <t t-esc="cat_page.get('title') or ('Courier ' + (cat_page['categ_name'] or '').upper() + ' Filleters Weights')"/>
                                                </span>
                                            </td>
                                            <td style="width: 42%; vertical-align: bottom; text-align: left; padding-left: 15px; font-size: 14px; font-weight: 500; color: #000; line-height: 1.5; border: none !important;">
                                                <div>For Packing between <t t-esc="res.get('packing_date_from_str', '')"/> and <t t-esc="res.get('packing_date_to_str', '')"/></div>
                                                <div>(Delivery <t t-esc="res.get('delivery_date_from_str', '')"/>-<t t-esc="res.get('delivery_date_to_str', '')"/>)</div>
                                            </td>
                                        </tr>
                                    </table>

                                    <div style="border-bottom: 2px solid #000; margin-top: 8px; margin-bottom: 12px;"></div>

                                    <table style="width: 100%; border-collapse: collapse; color: #000; margin-top: 0; border: none !important;">
                                        <thead>
                                            <tr style="border: none !important; border-bottom: 2px solid #000 !important;">
                                                <th style="width: 150px; text-align: left; vertical-align: middle; padding: 8px 15px 8px 0; font-size: 18px; font-weight: bold; border: none !important; border-bottom: 2px solid #000 !important;">
                                                    <div style="display: inline-block; width: 80px; text-align: right;">Total Kg</div>
                                                </th>
                                                <th style="text-align: left; vertical-align: middle; padding: 8px 0; font-size: 18px; font-weight: bold; border: none !important; border-bottom: 2px solid #000 !important;">
                                                    Stock Name
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody style="border: none !important;">
                                            <t t-foreach="cat_page['product_list']" t-as="prod">
                                                <tr style="border: none !important; border-bottom: 1px solid #000 !important;">
                                                    <td style="width: 150px; text-align: left; vertical-align: middle; padding: 8px 15px 8px 0; font-size: 17px; white-space: nowrap; border: none !important; border-bottom: 1px solid #000 !important;">
                                                        <span style="display: inline-block; width: 80px; text-align: right; font-weight: bold; font-size: 17px;">
                                                            <t t-esc="prod.get('formatted_weight') or ('%.2f' % prod['total_weight'])"/>
                                                        </span>
                                                        <span style="margin-left: 8px; font-size: 16px; font-weight: normal; color: #000;">Kg</span>
                                                    </td>
                                                    <td style="vertical-align: middle; padding: 8px 0; font-size: 17px; font-weight: 500; line-height: 1.35; color: #000; border: none !important; border-bottom: 1px solid #000 !important;">
                                                        <t t-esc="prod['product_name']"/>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <!-- FOOTER (one per article) -->
                            <div class="footer">
                                <div class="o_footer_content" style="font-family: Arial, Helvetica, sans-serif; font-size: 12px; font-weight: 500; color: #000;">
                                    <table style="width: 100%; border-collapse: collapse; border: none !important;">
                                        <tr style="border: none !important;">
                                            <td style="width: 50%; text-align: left; vertical-align: middle; border: none !important; padding: 0;">
                                                <span t-esc="res.get('print_date_str', '')"/>
                                            </td>
                                            <td style="width: 50%; text-align: right; vertical-align: middle; border: none !important; padding: 0;">
                                                Page <span class="page"/> of <span class="topage"/>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>

                        </t>
                    </t>
                    <t t-else="">
                        <div class="article">
                            <div class="page" style="font-family: Arial, Helvetica, sans-serif; color: #000; padding: 20px; background: #fff;">
                                <div style="font-size: 22px; font-weight: bold; margin-bottom: 10px;">Courier Dock Weight Report</div>
                                <div style="margin-top: 10px; font-size: 17px; color: #555;">
                                    No Courier Delivery orders found for the selected criteria.
                                </div>
                            </div>
                        </div>
                        <!-- keep the 1 footer : 1 article pairing even on empty pages -->
                        <div class="footer">
                            <div class="o_footer_content" style="font-family: Arial, Helvetica, sans-serif; font-size: 12px; color: #000;">
                                <table style="width: 100%; border-collapse: collapse; border: none !important;">
                                    <tr style="border: none !important;">
                                        <td style="width: 50%; text-align: left; border: none !important; padding: 0;">
                                            <span t-esc="res.get('print_date_str', '')"/>
                                        </td>
                                        <td style="width: 50%; text-align: right; border: none !important; padding: 0;">
                                            Page <span class="page"/> of <span class="topage"/>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </t>
                </t>

                <!-- ============ REGAL VAN DELIVERY ============ -->
                <t t-else="">
                    <t t-if="res.get('pages')">
                        <t t-foreach="res['pages']" t-as="combo_page">

                            <!-- BODY -->
                            <div class="article">
                                <div class="page" style="font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif; color: #000; padding: 0 10px; background: #fff;">
                                    <div style="margin-bottom: 6px;">
                                        <span style="font-size: 24px; font-weight: bold; color: #000; line-height: 1.2;">
                                            Dock Weight Breakdown Report
                                        </span>
                                    </div>

                                    <div style="margin-bottom: 24px;">
                                        <span style="font-size: 18px; font-weight: bold; color: #111;">
                                            <t t-esc="res['formatted_date']"/>
                                        </span>
                                    </div>

                                    <div style="font-size: 36px; font-weight: 900; color: #000; margin-bottom: 24px; letter-spacing: 0.5px;">
                                        <span style="display: inline-block; min-width: 180px; margin-right: 35px;">
                                            <t t-esc="combo_page['depot_name']"/>
                                        </span>
                                        <span><t t-esc="combo_page['categ_name']"/></span>
                                    </div>

                                    <div style="font-size: 16px; font-style: italic; font-weight: bold; color: #000; margin-bottom: 14px; padding-left: 2px;">
                                        Sold Weight (Kg)
                                    </div>

                                    <table style="width: 100%; border-collapse: collapse; color: #000; border: none !important;">
                                        <tbody style="border: none !important;">
                                            <t t-foreach="combo_page['product_list']" t-as="prod">
                                                <tr style="border: none !important;">
                                                    <td style="width: 100px; text-align: right; vertical-align: top; padding: 6px 30px 6px 0; font-size: 18px; font-weight: bold; white-space: nowrap; border: none !important;">
                                                        <t t-esc="'%.2f' % prod['total_weight']"/>
                                                    </td>
                                                    <td style="vertical-align: top; padding: 6px 0; font-size: 18px; font-weight: 500; line-height: 1.4; color: #000; border: none !important;">
                                                        <t t-esc="prod['product_name']"/>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <!-- FOOTER (one per article) -->
                            <div class="footer">
                                <div class="o_footer_content" style="font-family: Arial, Helvetica, sans-serif; font-size: 12px; color: #333;">
                                    <table style="width: 100%; border-collapse: collapse; border: none !important;">
                                        <tr style="border: none !important;">
                                            <td style="width: 50%; text-align: left; vertical-align: middle; border: none !important; padding: 0;">
                                                Printed at: <span t-esc="res.get('printed_at_str', '')"/>
                                            </td>
                                            <td style="width: 50%; text-align: right; vertical-align: middle; border: none !important; padding: 0;">
                                                Page <span class="page"/> of <span class="topage"/>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>

                        </t>
                    </t>
                    <t t-else="">
                        <div class="article">
                            <div class="page" style="font-family: Arial, Helvetica, sans-serif; color: #000; padding: 20px; background: #fff;">
                                <div style="margin-top: 20px; font-size: 18px; color: #555;">
                                    No orders or products found for the selected criteria.
                                </div>
                            </div>
                        </div>
                        <div class="footer">
                            <div class="o_footer_content" style="font-family: Arial, Helvetica, sans-serif; font-size: 12px; color: #333;">
                                <table style="width: 100%; border-collapse: collapse; border: none !important;">
                                    <tr style="border: none !important;">
                                        <td style="width: 50%; text-align: left; border: none !important; padding: 0;">
                                            Printed at: <span t-esc="res.get('printed_at_str', '')"/>
                                        </td>
                                        <td style="width: 50%; text-align: right; border: none !important; padding: 0;">
                                            Page <span class="page"/> of <span class="topage"/>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </t>
                </t>

            </t>
        </t>
    </template>
</odoo>
