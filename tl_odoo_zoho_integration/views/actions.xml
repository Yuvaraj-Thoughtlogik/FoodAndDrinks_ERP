<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="action_zoho_config_fields" model="ir.actions.act_window">
        <field name="name">Zoho Sync Fields Map</field>
        <field name="res_model">zoho.config.fields.map</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'group_by': 'cr_sync_module_id'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No fields mapping found
            </p>
            <p>
                Fields mapping defines how Zoho fields connect with Odoo fields.
                Create a new mapping to sync data between Zoho modules and Odoo models.
            </p>
        </field>
    </record>
    <!-- Action and Menu for Zoho Modules -->
    <record id="action_zoho_config_module" model="ir.actions.act_window">
        <field name="name">Zoho Sync Modules</field>
        <field name="res_model">zoho.config.module</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Zoho modules found
            </p>
            <p>
                Zoho modules represent the entities you want to synchronize
                (like Leads, Contacts, Invoices, or Creator apps).
                Add or import modules here to enable syncing.
            </p>
        </field>
    </record>

    <record id="action_open_first_zoho_config" model="ir.actions.server">
        <field name="name">Open First Zoho Config</field>
        <field name="model_id" ref="model_zoho_config"/>
        <field name="state">code</field>
        <field name="code">action = env['zoho.config'].open_first_record()</field>
    </record>

    <record id="action_zoho_config_logs" model="ir.actions.act_window">
        <field name="name">Zoho Config Logs</field>
        <field name="res_model">zoho.config.logs</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_zoho_config_application" model="ir.actions.act_window">
        <field name="name">Zoho Applications</field>
        <field name="res_model">zoho.config.application</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Zoho applications found
            </p>
            <p>
                Install or activate Zoho integration addons
                (e.g. CRM, Creator, Books, ...).<br/>
                Applications will appear here automatically once the related addon is installed.
            </p>
        </field>

    </record>


