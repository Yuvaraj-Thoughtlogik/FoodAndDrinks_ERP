    <record id="action_compute_zoho_application_root" model="ir.actions.server">
        <field name="name">Zoho Application</field>
        <field name="model_id" ref="model_zoho_config"/>
        <field name="state">code</field>
        <field name="code">action = env['zoho.config'].open_menu()</field>
    </record>

    <record id="action_open_after_install" model="ir.actions.server">
        <field name="name">Open First Zoho Config</field>
        <field name="model_id" ref="model_zoho_config"/>
        <field name="state">code</field>
        <field name="code">action = env['zoho.config'].action_open_after_install()</field>
    </record>

    <record id="open_config_after_install" model="ir.actions.todo">
        <field name="action_id" ref="tl_odoo_zoho_integration.action_compute_zoho_application_root"/>
    </record>



