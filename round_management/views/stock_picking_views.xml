<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_picking_tree_round_management" model="ir.ui.view">
        <field name="name">stock.picking.tree.round.management</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="default_group_by">batch_id</attribute>
            </xpath>
            <xpath expr="//field[@name='origin']" position="after">
                <field name="batch_id" string="Round Batch" domain="[('state', 'in', ('draft', 'in_progress'))]"/>
                <field name="delivery_date" string="Delivery Date" widget="date"/>
                <field name="delivery_channel" string="Delivery Channels"/>
            </xpath>
        </field>
    </record>


    <!-- Primary Search View -->
    <record id="view_picking_search_round_management" model="ir.ui.view">
        <field name="name">stock.picking.search.round.management</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search"/>
        <field name="mode">primary</field>

        <field name="arch" type="xml">

            <xpath expr="//search" position="inside">

                <!-- Search Fields -->
                <field name="name" string="Reference"/>
                <field name="partner_id" string="Contact"/>
                <field name="origin" string="Source Document"/>
                <field name="batch_id" string="Round Batch"/>
                <field name="delivery_channel" string="Delivery Channel"/>


                <!-- Delivery Date Today -->
                <filter
                    string="Delivery Date: Today"
                    name="filter_delivery_date_today"
                    domain="[
                        ('delivery_date', '&gt;=', context_today()),
                        ('delivery_date', '&lt;', context_today() + relativedelta(days=1))
                    ]"
                />


                <!-- Delivery Channel -->
                <filter
                    string="Regal Van Delivery"
                    name="filter_regal_van"
                    domain="[('delivery_channel', '=', 'regal_van')]"
                />

                <filter
                    string="Courier Delivery"
                    name="filter_courier"
                    domain="[('delivery_channel', '=', 'courier')]"
                />


                <!-- Late Orders -->
                <filter
                    string="Late Orders"
                    name="filter_late_orders"
                    domain="[
                        ('scheduled_date', '&lt;', context_today()),
                        ('state', 'not in', ['done', 'cancel'])
                    ]"
                />


                <separator/>


                <!-- Group By -->
                <filter
                    string="Round Batch"
                    name="groupby_round_batch"
                    context="{'group_by': 'batch_id'}"
                />

                <filter
                    string="Delivery Channel"
                    name="groupby_delivery_channel"
                    context="{'group_by': 'delivery_channel'}"
                />

                <filter
                    string="Status"
                    name="groupby_state"
                    context="{'group_by': 'state'}"
                />

            </xpath>

        </field>
    </record>
    
     <record id="view_mrp_production_filter_inherit_delivery_date" model="ir.ui.view">
        <field name="name">mrp.production.select.inherit.delivery.date</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.view_mrp_production_filter"/>
        <field name="arch" type="xml">
            <!-- Add custom filter inside the search view -->
            <xpath expr="//search" position="inside">
                <filter string="Delivery Date: Today"
                        name="filter_delivery_date_today"
                        domain="[('delivery_date', '=', context_today().strftime('%Y-%m-%d'))]"/>
            </xpath>
            <xpath expr="//group" position="inside">
            <filter string="Product Category" 
                    name="group_by_product_category" 
                    context="{'group_by': 'product_categ_id'}"/>
        </xpath>
        </field>
    </record>
    
    
    <record id="mrp_production_tree_view_inherit_round_batch" model="ir.ui.view">
        <field name="name">mrp.production.list.inherit.round.batch</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="batch_id" string="Round Batch" optional="show"/>
                <field name="delivery_date" string="Delivery Date" optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>
