<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fleet_vehicle_view_form_inherit_rounds" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.inherit.rounds</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
        <field name="arch" type="xml">
           
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_driver_rounds"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-truck">
                    <field name="round_batch_count" widget="statinfo" string="Driver Rounds"/>
                </button>
               <!-- <button name="action_view_vehicle_track_history"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-road">
                    <field name="track_history_count" widget="statinfo" string="Vehicle Tracks"/>
                </button>-->
            </xpath>
        </field>
    </record>
    
    
    
      <record id="fleet_vehicle_model_view_form_inherit" model="ir.ui.view">
          <field name="name">fleet.vehicle.model.form.inherit</field>
          <field name="model">fleet.vehicle.model</field>
          <field name="inherit_id" ref="fleet.fleet_vehicle_model_view_form"/>
          <field name="arch" type="xml">
              <xpath expr="//field[@name='vehicle_type']" position="attributes">
                  <attribute name="widget">selection</attribute>
              </xpath>
             
                  <xpath expr="//page[@name='information']/group/group[1]" position="attributes">
                      <attribute name="invisible">0</attribute>
                  </xpath>

                  
                  <xpath expr="//group[@name='group_engine']" position="attributes">
                      <attribute name="invisible">0</attribute>
                  </xpath>
                  
                  
          </field>
      </record>
   </odoo>
