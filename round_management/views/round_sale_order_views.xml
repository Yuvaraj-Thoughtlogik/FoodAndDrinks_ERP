<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Inherit Sale Order Search View to Add 'Delivery Date Today' Filter -->
        <record id="view_sales_order_filter_round_today" model="ir.ui.view">
            <field name="name">sale.order.list.select.round.today</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_sales_order_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="attributes">
                    <attribute name="filter_domain">
                        ['|', '|', '|', '|', '|', '|', '|', '|', '|', '|', '|',
                        ('name', 'ilike', self),
                        ('client_order_ref', 'ilike', self),
                        ('partner_id', 'child_of', self),
                        ('customer_code', 'ilike', self),
                        ('partner_id.zip', 'ilike', self),
                        ('partner_id.phone', 'ilike', self),
                        ('partner_shipping_id.zip', 'ilike', self),
                        ('partner_shipping_id.phone', 'ilike', self),
                        ('round_id', 'ilike', self),
                        ('round_full_name', 'ilike', self),
                        ('round_code', 'ilike', self),
                        ('batch_id', 'ilike', self)]
                    </attribute>
                </xpath>
                <xpath expr="//search" position="inside">
                    <field name="customer_code" string="Customer Code"
                           filter_domain="[('customer_code', 'ilike', self)]"/>
                    <filter string="Delivery Date Today"
                            name="filter_delivery_today"
                            domain="[
                                ('commitment_date', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')),
                                ('commitment_date', '&lt;=', context_today().strftime('%Y-%m-%d 23:59:59'))
                            ]"/>
                </xpath>
            </field>
        </record>

