<odoo>
    <record id="view_order_form_inherit_round" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.round</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
           
            <!-- LEFT COLUMN FIELDS -->
            <xpath expr="//field[@name='partner_shipping_id']" position="after">

                <!-- Delivery Round (Code + Name + Alternative Button) -->
                <label for="round_id" string="Delivery Round"/>
                <div class="o_row">
                    <field name="round_code" placeholder="Code" style="max-width: 1000px;" readonly="1"/>
                    <field name="round_id" placeholder="Select Round..."/>
                </div>

                <!-- Batch Code -->
                
                <label for="batch_id" string="Batch Code"/>
                  <div class="o_row">
                      <field name="batch_id" 
                             string="Batch Code"
                             context="{
                                 'list_view_ref': 'round_management.view_round_batch_tree',
                                 'order': 'delivery_date asc'
                             }"
                             options="{'no_create': True}"/>
                      <button name="action_select_alt_delivery_round"
                              string="Alt Delivery Rnd"
                              type="object"
                              icon="fa-truck"
                              class="oe_highlight o_alt_round_btn ms-1"/>
                  </div>


                <!-- Delivery Date + Day Name -->
                <label for="commitment_date" string="Delivery Date"/>
                <div class="o_row">
                    <field name="commitment_date" invisible="1"/>
                    <field name="delivery_date"/>
                    <field name="delivery_day_name" readonly="1" class="fw-bold text-primary ms-2"/>
                </div>

                <!-- Week N° + Helper Text -->
                <label for="week_number" string="Week N°"/>
                <div class="o_row">
                    <field name="week_number" readonly="1" style="max-width: 90px;"/>
                    <span class="text-muted ms-2">(Week and Year ie. 202630)</span>
                </div>

                <!-- Requested Delivery Time Range -->
               <label for="requested_delivery_after" string="Requested Delivery Time" invisible="1"/>
                <div class="o_row">
                    <!--<span class="me-1">After:</span>-->
                    <field name="requested_delivery_after" widget="float_time" placeholder="12:00" invisible="1"/>
                   <!-- <span class="ms-3 me-1">Before:</span>-->
                    <field name="requested_delivery_before" widget="float_time" placeholder="17:00" invisible="1"/>
                </div>


            </xpath>


            <!-- RIGHT COLUMN FIELDS -->
            <xpath expr="//field[@name='payment_term_id']" position="after">


                <!-- Last Ring Date -->
                <field name="last_ring_date" string="Last Ring Date" readonly="0"/>

                <!-- Checkbox Flags Side-by-Side -->
                <label for="is_late_order" string="Order Flags"/>
                <div>
                    <div class="row g-0 align-items-baseline" style="max-width: 460px;">
                        <div class="col-4 d-flex align-items-baseline">
                            <field name="is_late_order" class="me-1"/>
                            <label for="is_late_order" string="Late Order" class="mb-0 text-nowrap"/>
                        </div>
                       <div class="col-4 d-flex align-items-baseline">
                            <field name="is_staff_order" class="me-1"/>
                            <label for="is_staff_order" string="Staff Order" class="mb-0 text-nowrap"/>
                        </div>
                        <div class="col-4 d-flex align-items-baseline">
                            <field name="is_b2b" class="me-1"/>
                            <label for="is_b2b" string="B2B Order" class="mb-0 text-nowrap"/>
                        </div>
                    </div>
                </div>

                <!-- Payment Modes Checkboxes (2 Lines) -->
                <label for="pay_card_reader" string="Payment Modes"/>
                <div>
                    <div class="row g-0 align-items-baseline mb-1" style="max-width: 460px;">
                        <div class="col-4 d-flex align-items-baseline">
                            <field name="pay_card_reader" class="me-1"/>
                            <label for="pay_card_reader" string="Card Reader" class="mb-0 text-nowrap"/>
                        </div>
                        <div class="col-4 d-flex align-items-baseline">
                            <field name="pay_kb" class="me-1"/>
                            <label for="pay_kb" string="K/B" class="mb-0 text-nowrap"/>
                        </div>
                        <div class="col-4 d-flex align-items-baseline">
                            <field name="pay_lnp" class="me-1"/>
                            <label for="pay_lnp" string="LNP" class="mb-0 text-nowrap"/>
                        </div>
                    </div>
                    <div class="row g-0 align-items-baseline" style="max-width: 460px;">
                        <div class="col-4 d-flex align-items-baseline">
                            <field name="pay_cash" class="me-1"/>
                            <label for="pay_cash" string="Cash" class="mb-0 text-nowrap"/>
                        </div>
                        <div class="col-4 d-flex align-items-baseline">
                            <field name="pay_cheque" class="me-1"/>
                            <label for="pay_cheque" string="Cheque" class="mb-0 text-nowrap"/>
                        </div>
                        <div class="col-4 d-flex align-items-baseline">
                            <field name="pay_card" class="me-1"/>
                            <label for="pay_card" string="Card" class="mb-0 text-nowrap"/>
                        </div>
                    </div>
                </div>

                <!-- Delivery Times -->
                <field name="delivery_times" string="Delivery Times" placeholder="e.g. 08:00 to 12:00"/>
                <field name="is_alternative_round" invisible="0"/>


            </xpath>

            <!-- BOTTOM SECTION: Side-by-Side Notes (Order Notes & Permanent Notes) -->
            <xpath expr="//group[@name='order_details']" position="after">
                <div class="row mt-3 mb-3">
                    <div class="col-6">
                        <label for="note" string="Order Notes:-" class="fw-bold mb-1"/>
                        <field name="note"
                               placeholder="Enter specific order notes..."
                               nolabel="1"
                               style="min-height: 100px;"/>
                    </div>
                    <div class="col-6">
                        <label for="permanent_notes" string="Permanent Notes:-" class="fw-bold text-primary mb-1"/>
                        <field name="permanent_notes"
                               placeholder="e.g. 1-2, shop, both, haddock, no, no, 2, no budget"
                               nolabel="1"
                               style="min-height: 100px;"/>
                    </div>
                </div>
            </xpath>

            <xpath expr="//header" position="inside">
                <button name="action_duplicate"
                        type="object"
                        string="Duplicate"
                        class="btn-secondary"/>
            </xpath>

        </field>
    </record>

    <record id="view_order_tree_inherit_round_management" model="ir.ui.view">
        <field name="name">sale.order.tree.inherit.round.management</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="customer_code" string="Customer Code" optional="show"/>
                <field name="round_id" optional="show"/>
                <field name="round_code" optional="show"/>
                <field name="batch_id" optional="show"/>
                <field name="delivery_date" string="Delivery Date" widget="date" optional="show"/>
                <field name="delivery_times" optional="show"/>
                <field name="week_number" optional="show"/>


                <field name="is_late_order" widget="boolean_toggle" optional="hide"/>

                <field name="is_staff_order" optional="hide"/>
                <field name="is_b2b" optional="hide"/>
            </xpath>

        </field>
    </record>

    <record id="view_quotation_tree_inherit_round_management" model="ir.ui.view">
        <field name="name">sale.quotation.tree.inherit.round.management</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree_with_onboarding"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="round_id" optional="show"/>
                <field name="round_code" optional="show"/>
                <field name="batch_id" optional="show"/>
                <field name="delivery_date" string="Delivery Date" widget="date" optional="show"/>
                <field name="delivery_times" optional="show"/>
                <field name="week_number" optional="show"/>


                <field name="is_late_order" widget="boolean_toggle" optional="hide"/>

               <field name="is_staff_order" optional="hide"/>
                <field name="is_b2b" optional="hide"/>
            </xpath>
        </field>
    </record>

   <record id="view_order_form_inherit_round_time_readonly_v2" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.round.time.readonly</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">


            <xpath expr="//form" position="inside">
                <field name="no_between_times_round" invisible="1"/>
            </xpath>


           <!-- <xpath expr="//field[@name='requested_delivery_after']" position="attributes">
                <attribute name="readonly">no_between_times_round == True</attribute>
            </xpath>


            <xpath expr="//field[@name='requested_delivery_before']" position="attributes">
                <attribute name="readonly">no_between_times_round == True</attribute>
            </xpath>-->

        </field>
    </record>
    
    
    <record id="view_order_form_inherit_round_v4" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.round.v4</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='name']" position="after">
                <field name="special_requirements_notes_id" 
                       options="{'no_create': False, 'no_create_edit': False}"/>
            </xpath>
        </field>
    </record>

<record id="product_pricelist_view_inherit_category" model="ir.ui.view">
        <field name="name">product.pricelist.form.inherit.category</field>
        <field name="model">product.pricelist</field>
        <field name="inherit_id" ref="product.product_pricelist_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='currency_id']" position="after">
                <field name="pricelist_category" widget="radio" options="{'horizontal': true}"/>
            </xpath>
        </field>
    </record>
    
    
    <record id="view_sales_order_filter_inherit_immediate_search" model="ir.ui.view">
        <field name="name">sale.order.list.select.inherit.immediate.search</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            
            <!-- Replace the default 'name' field so it becomes the primary Enter-key action -->
            <xpath expr="//search/field[@name='name']" position="replace">
                <field name="name" 
                       string="Order / Customer Code / Zip / Phone" 
                       filter_domain="['|', '|', '|', '|',
                           ('name', 'ilike', self),
                           ('partner_id.name', 'ilike', self),
                           ('partner_id.customer_code', 'ilike', self),
                           ('partner_id.zip', 'ilike', self),
                           ('partner_id.phone', 'ilike', self)
                       ]"/>
            </xpath>

        </field>
    </record>
    
    <record id="view_order_form_inherit_hide_product_ref" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.hide.product.ref</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='order_line']/list/field[@name='product_id']" position="attributes">
                <attribute name="context">{'display_default_code': False}</attribute>
            </xpath>

        </field>
    </record>
    
    <record id="view_order_form_inherit_order_history" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.order.history</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            
            <xpath expr="//notebook" position="inside">
                <page string="Order History" name="order_history_tab">
                    <group string="Previous Orders">
                        <field name="order_history_ids" mode="list,form" nolabel="1" readonly="1">
                            
                            <!-- Master Order History List -->
                            <list create="0" delete="0" edit="0">
                                <field name="name" string="Ord Num"/>
                                <field name="is_late_order" string="Late" widget="boolean_toggle"/>
                                
                                <!-- Formatted as Date-Only without time -->
                                <field name="date_order" string="Ord Date" widget="date"/>
                                <field name="delivery_date" string="Del Date"/>
                                
                                <field name="pay_type" string="Pay Type"/>
                                <field name="round_id" string="Round Name"/>
                                <field name="amount_total" string="Total £" widget="monetary"/>
                                
                                <!-- Delivery Time Slot -->
                                <field name="delivery_times" string="Time"/>
                                
                                <field name="note" string="Notes"/>
                                
                                <!-- Alt Addr Flag: Yes / No -->
                                <field name="has_alt_address" string="Alt Addr"/>
                                
                                <field name="state" widget="badge" 
                                       decoration-success="state in ('sale', 'done')" 
                                       decoration-info="state == 'draft'" 
                                       decoration-muted="state == 'cancel'"/>
                                <field name="batch_id" string="Batch N°"/>
                            </list>

                            <!-- Inline Form View for line items inspection -->
                            <form string="Order Details">
                                <sheet>
                                    <group col="4">
                                        <field name="name" string="Order Number"/>
                                        <field name="date_order" widget="date"/>
                                        <field name="delivery_date"/>
                                        <field name="delivery_times"/>
                                        <field name="has_alt_address"/>
                                        <field name="amount_total" widget="monetary"/>
                                    </group>
                                    <notebook>
                                        <page string="Order Lines">
                                            <field name="order_line" readonly="1">
                                                <list create="0" delete="0" edit="0">
                                                    <field name="sequence" string="Sub Or..."/>
                                                    <field name="product_id" string="Code"/>
                                                    <field name="name" string="Stk/Prc Name"/>
                                                    <field name="product_uom_qty" string="Quantity"/>
                                                    <field name="price_unit" string="Price £"/>
                                                    <field name="price_subtotal" string="Gross £"/>
                                                    <field name="discount" string="Discount £"/>
                                                    <field name="qty_delivered_method" string="Status"/>
                                                </list>
                                            </field>
                                        </page>
                                    </notebook>
                                </sheet>
                            </form>

                        </field>
                    </group>
                </page>
            </xpath>

        </field>
    </record>
    
    
    <record id="view_order_form_inherit_alt_delivery_address" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.alt.delivery.address</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            
            
            <xpath expr="//field[@name='partner_id']" position="replace">
                <label for="partner_id"/>
                <div class="o_row">
                    <field name="partner_id" 
                           widget="res_partner_many2one" 
                           context="{'res_partner_search_mode': 'customer', 'show_address': 1, 'show_vat': True}" 
                           options='{"always_reload": True}'/>
                    <button name="action_open_delivery_address_wizard" 
                            type="object" 
                            string="Alt Delivery Address" 
                            class="btn btn-primary btn-sm" 
                            icon="fa-map-marker"
                            invisible="not partner_id"/>
                </div>
            </xpath>

            
            <xpath expr="//field[@name='partner_invoice_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            
            <xpath expr="//field[@name='partner_shipping_id']" position="attributes">
                <attribute name="readonly">1</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>

        </field>
    </record>
    
    <record id="view_order_form_inherit_hide_fields" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.hide.fields</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- Hide Payment Terms (payment_term_id) -->
            <xpath expr="//field[@name='payment_term_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Hide Last Ring Date -->
            <xpath expr="//field[@name='last_ring_date']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

        </field>
    </record>

    <record id="view_order_form_inherit_hide_shipping_weight" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.hide.shipping.weight</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="delivery.view_order_form_with_carrier"/>
        <field name="arch" type="xml">

            <!-- Hide Shipping Weight (added by the delivery module) -->
            <xpath expr="//field[@name='shipping_weight']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

        </field>
    </record>

</odoo>
