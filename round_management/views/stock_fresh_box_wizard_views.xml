<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Wizard View -->
   <record id="view_stock_fresh_box_wizard_form" model="ir.ui.view">
        <field name="name">stock.fresh.box.wizard.form</field>
        <field name="model">stock.fresh.box.wizard</field>
        <field name="arch" type="xml">
            <form string="Pack Box &amp; MO Generator">
                <sheet>
                    <group>
                        <group string="Filter Criteria">
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="include_late_orders"/>
                        </group>
                        <group string="Channel Selection">
                            <field name="delivery_channel" widget="radio"/>
                        </group>
                    </group>

                    <div class="text-muted mb-3">
                        * All product categories will be analyzed in the table below. Manufacturing Orders will be generated <b>strictly for Fresh category items</b>.
                    </div>

                    <button name="action_analyze_orders" 
                            string="Analyze Orders &amp; Calculate Boxes" 
                            type="object" 
                            class="btn-secondary mb-3"/>

                    <notebook>
                        <page string="Box Breakdown Table (All Categories)">
                            <field name="line_ids" readonly="1">
                                <list no_open="1">
                                    <field name="sale_order_id"/>
                                    <field name="product_id"/>
                                    <field name="category_id"/>
                                    <field name="box_number"/>
                                    <field name="box_weight" string="Box Qty / Weight (kg)"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_generate_mo" 
                            string="Packbox Generate MO (Fresh Only)" 
                            type="object" 
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- History List View -->
    <record id="view_stock_fresh_box_history_list" model="ir.ui.view">
        <field name="name">stock.fresh.box.history.list</field>
        <field name="model">stock.fresh.box.history</field>
        <field name="arch" type="xml">
            <list string="Pack Box Execution History">
                <field name="wizard_date"/>
                <field name="user_id"/>
                <field name="delivery_channel"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="total_analyzed_lines"/>
                <field name="total_fresh_mos_created"/>
                <field name="include_late_orders" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- History Form View -->
    <record id="view_stock_fresh_box_history_form" model="ir.ui.view">
        <field name="name">stock.fresh.box.history.form</field>
        <field name="model">stock.fresh.box.history</field>
        <field name="arch" type="xml">
            <form string="Pack Box Execution History" create="false" edit="false">
                <sheet>
                    <group>
                        <group string="Execution Summary">
                            <field name="wizard_date"/>
                            <field name="user_id"/>
                            <field name="delivery_channel"/>
                            <field name="include_late_orders"/>
                        </group>
                        <group string="Date &amp; Metrics">
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="total_analyzed_lines"/>
                            <field name="total_fresh_mos_created"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Box Breakdown Lines History">
                            <field name="line_ids">
                                <list no_open="1">
                                    <field name="sale_order_id"/>
                                    <field name="product_id"/>
                                    <field name="category_id"/>
                                    <field name="box_number"/>
                                    <field name="box_weight"/>
                                    <field name="delivery_date"/>
                                    <field name="delivery_channel"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- History Search View (FOR PACK BOX HISTORY MAIN VIEW) -->
    <record id="view_stock_fresh_box_history_search" model="ir.ui.view">
        <field name="name">stock.fresh.box.history.search</field>
        <field name="model">stock.fresh.box.history</field>
        <field name="arch" type="xml">
            <search string="Search Pack Box History">
                <field name="user_id"/>
                <field name="delivery_channel"/>
                <field name="start_date"/>
                <field name="end_date"/>

                <filter string="Includes Late Orders" name="filter_late_orders" domain="[('include_late_orders', '=', True)]"/>
                <separator/>
                <filter string="Courier Delivery" name="filter_courier" domain="[('delivery_channel', '=', 'courier')]"/>
                <filter string="Regal Van Delivery" name="filter_regal_van" domain="[('delivery_channel', '=', 'regal_van')]"/>

               
                    <filter string="User" name="groupby_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Delivery Channel" name="groupby_delivery_channel" context="{'group_by': 'delivery_channel'}"/>
                    <filter string="Run Date" name="groupby_wizard_date" context="{'group_by': 'wizard_date:day'}"/>
                    <filter string="Start Date" name="groupby_start_date" context="{'group_by': 'start_date:day'}"/>
                    <filter string="End Date" name="groupby_end_date" context="{'group_by': 'end_date:day'}"/>
               
            </search>
        </field>
    </record>

    <!-- History Line Search View -->
    <record id="view_stock_fresh_box_history_line_search" model="ir.ui.view">
    <field name="name">stock.fresh.box.history.line.search</field>
    <field name="model">stock.fresh.box.history.line</field>
    <field name="arch" type="xml">
        <search string="Search Box History Lines">
            <field name="sale_order_id"/>
            <field name="product_id"/>
            <field name="category_id"/>
            <field name="delivery_channel"/>
            <field name="delivery_date"/>

            <filter string="Courier Delivery" name="filter_courier" domain="[('delivery_channel', '=', 'courier')]"/>
            <filter string="Regal Van Delivery" name="filter_regal_van" domain="[('delivery_channel', '=', 'regal_van')]"/>

           
                <filter string="Delivery Date" name="groupby_delivery_date" context="{'group_by': 'delivery_date:day'}"/>
                <filter string="Product Category" name="groupby_product_category" context="{'group_by': 'category_id'}"/>
                <filter string="Delivery Channel" name="groupby_delivery_channel" context="{'group_by': 'delivery_channel'}"/>
            
        </search>
    </field>
</record>

    <!-- MO List View Inheritance -->
    <record id="view_mrp_production_tree_inherit_delivery" model="ir.ui.view">
        <field name="name">mrp.production.list.inherit.delivery</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='origin']" position="after">
                <field name="round_batch_id" optional="show"/>
                <field name="delivery_date" optional="show"/>
                <field name="delivery_channel" optional="show"/>
                <field name="is_late_order" optional="show"/>
                <field name="product_category_id" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- MO Search View Inheritance -->
    <record id="view_mrp_production_filter_inherit_delivery" model="ir.ui.view">
        <field name="name">mrp.production.select.inherit.delivery</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.view_mrp_production_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="product_category_id"/>
                <field name="delivery_date"/>
                <field name="delivery_channel"/>
                <field name="round_batch_id"/>
                <field name="is_late_order"/>

                <filter string="Late Orders" name="filter_late_orders" domain="[('is_late_order', '=', True)]"/>

                
                    <filter string="Delivery Date" name="groupby_delivery_date" context="{'group_by': 'delivery_date:day'}"/>
                    <filter string="Product Category" name="groupby_product_category" context="{'group_by': 'product_category_id'}"/>
                    <filter string="Delivery Channel" name="groupby_delivery_channel" context="{'group_by': 'delivery_channel'}"/>
                    <filter string="Round Batch" name="groupby_round_batch" context="{'group_by': 'round_batch_id'}"/>
                
            </xpath>
        </field>
    </record>
    
    <record id="view_stock_fresh_box_history_line_list" model="ir.ui.view">
        <field name="name">stock.fresh.box.history.line.list</field>
        <field name="model">stock.fresh.box.history.line</field>
        <field name="arch" type="xml">
            <list string="Pack Box History Breakdown">
                <field name="sale_order_id"/>
                <field name="product_id"/>
                <field name="category_id"/>
                <field name="box_number"/>
                <field name="box_weight" string="Box Weight / Qty" sum="Total Weight"/>
                <field name="delivery_date"/>
                <field name="delivery_channel"/>
            </list>
        </field>
    </record>
    
    <record id="action_stock_fresh_box_history_line_grouped" model="ir.actions.act_window">
    <field name="name">Pack Box Split Fresh History Lines</field>
    <field name="res_model">stock.fresh.box.history.line</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="view_stock_fresh_box_history_line_search"/>
    <field name="context">{
        'search_default_groupby_delivery_date': 1,
        'search_default_groupby_product_category': 1,
        'search_default_groupby_delivery_channel': 1
    }</field>
</record>

    <!-- Actions & Menus -->
    <record id="action_stock_fresh_box_wizard" model="ir.actions.act_window">
        <field name="name">Pack Box &amp; Generate MO</field>
        <field name="res_model">stock.fresh.box.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_stock_fresh_box_history" model="ir.actions.act_window">
        <field name="name">Pack Box History</field>
        <field name="res_model">stock.fresh.box.history</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_stock_fresh_box_history_list"/>
        <field name="search_view_id" ref="view_stock_fresh_box_history_search"/>
    </record>

    <menuitem id="menu_stock_fresh_box_wizard"
              name="Pack Box &amp; Generate MO"
              parent="round_management.menu_round_management_order_management_root"
              action="action_stock_fresh_box_wizard"
              sequence="25"/>

   <menuitem id="menu_stock_fresh_box_history_lines"
          name="Pack Box Detailed History"
          parent="round_management.menu_round_management_order_management_root"
          action="action_stock_fresh_box_history_line_grouped"
          sequence="27"/>
</odoo>
