<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_round_batch_warning_wizard_form" model="ir.ui.view">
        <field name="name">round.batch.warning.wizard.form</field>
        <field name="model">round.batch.warning.wizard</field>
        <field name="arch" type="xml">
            <form string="Existing Active Batch Warning">
                <div class="alert alert-warning mb-0" role="alert">
                    <field name="message" readonly="1"/>
                </div>
                <footer>
                    <button string="OK" name="action_confirm" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>