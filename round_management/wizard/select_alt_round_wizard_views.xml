<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_select_alt_round_wizard_form" model="ir.ui.view">
        <field name="name">select.alt.round.wizard.form</field>
        <field name="model">select.alt.round.wizard</field>
        <field name="arch" type="xml">
            <form string="Select Alternative Delivery Round Batch">
                <field name="sale_order_id" invisible="1"/>

                <field name="line_ids">
                    <list editable="bottom" create="false"  delete="false"  decoration-danger="is_alt_limit_reached">
                        <!--<field name="selected" string="" widget="boolean_toggle" readonly="state == 'pln'"/>-->
                        <field name="selected"
                               string=""
                               options="{'autosave': false}"
                               widget="boolean_toggle"
                               readonly="state == 'pln'"
                               decoration-danger="is_alt_limit_reached"/>
                        <field name="code" string="Batch Code"  readonly="state == 'pln'" decoration-muted="state == 'pln'"/>
                        <field name="round_id" options="{'no_open':True}" decoration-muted="state == 'pln'"/>
                        <field name="reference"/>
                        <field name="depot_id" options="{'no_open':True}" decoration-muted="state == 'pln'"/>
                        <field name="delivery_date" decoration-muted="state == 'pln'"/>
                        <field name="is_alt_limit_reached" decoration-muted="state == 'pln'"/>
                        <field name="state"
                               widget="badge"
                               decoration-info="state == 'pln'"
                               decoration-warning="state == 'act'"
                               decoration-primary="state == 'prt'"
                               decoration-success="state == 'com'"
                               decoration-danger="state == 'cancel'"/>
                    </list>
                </field>

                <footer>
                    <button name="action_apply_round"
                            string="Apply"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
