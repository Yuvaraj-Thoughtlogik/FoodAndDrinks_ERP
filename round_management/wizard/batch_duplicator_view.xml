<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 1. WIZARD FORM MODAL -->
    <record id="view_batch_duplicator_wizard_form" model="ir.ui.view">
        <field name="name">batch.duplicator.wizard.form</field>
        <field name="model">batch.duplicator.wizard</field>
        <field name="arch" type="xml">
            <form string="Duplicate Round Batches">
                <p class="alert alert-warning" role="alert">
                    Are you sure you want to duplicate the selected round batches to a new target delivery date?
                </p>
                <group>
                    <field name="delivery_date"/>
                    <field name="reference" placeholder="e.g. Late Summer Delivery Cycle"/>
                </group>
                <footer>
                    <button name="action_duplicate_batches" string="Yes, Duplicate Batches" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    
    <record id="action_batch_duplicator_wizard" model="ir.actions.act_window">
        <field name="name">Duplicate Round Batches</field>
        <field name="res_model">batch.duplicator.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    
    <record id="action_server_duplicate_batches" model="ir.actions.server">
        <field name="name">Duplicate Round Batches</field>
        <field name="model_id" ref="model_round_management_batch"/>
        <field name="binding_model_id" ref="model_round_management_batch"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">
action = env['batch.duplicator.wizard'].action_open_duplicator_wizard()
        </field>
    </record>

    
    <record id="view_driver_rounds_tree_inherit_duplicate" model="ir.ui.view">
        <field name="name">driver.rounds.tree.inherit.duplicate</field>
        <field name="model">round.management.batch</field>
        <field name="inherit_id" ref="round_management.view_driver_rounds_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <header>
                    <button name="%(action_batch_duplicator_wizard)d" 
                            string="Duplicate Batches" 
                            type="action" 
                            class="btn-primary" 
                            icon="fa-copy"/>
                </header>
            </xpath>
        </field>
    </record>

   
    <record id="view_round_batch_tree_inherit_duplicate" model="ir.ui.view">
        <field name="name">round.batch.tree.inherit.duplicate</field>
        <field name="model">round.management.batch</field>
        <field name="inherit_id" ref="round_management.view_round_batch_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <header>
                    <button name="%(action_batch_duplicator_wizard)d" 
                            string="Duplicate Batches" 
                            type="action" 
                            class="btn-primary" 
                            icon="fa-copy"/>
                </header>
            </xpath>
        </field>
    </record>

    
