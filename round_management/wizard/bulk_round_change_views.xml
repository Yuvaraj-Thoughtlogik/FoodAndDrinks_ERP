<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- BULK CUSTOMER ROUND TRANSFER FORM -->
    <record id="view_wizard_bulk_round_change_form" model="ir.ui.view">
        <field name="name">wizard.bulk.round.change.form</field>
        <field name="model">wizard.bulk.round.change</field>
        <field name="arch" type="xml">
            <form string="Bulk Customer Round Transfer">
                <group>
                    <group>
                        <field name="old_round_id" options="{'no_create': True}"/>
                        <field name="include_inactive"/>
                    </group>
                    <group>
                        <field name="new_round_id" options="{'no_create': True}"/>
                    </group>
                </group>
                 <group>
                    <group>
                        <!-- CHECKBOX FOR INACTIVE/CLOSED CUSTOMERS -->
                        <field name="include_inactive" widget="boolean_toggle"/>
                    </group>
                </group>

                <group>
                    <field name="available_partner_ids" invisible="1"/>
                    <!-- CUSTOMER SELECTION FILTERED BY COMPUTED DOMAIN -->
                    <field name="partner_ids" 
                           domain="[('id', 'in', available_partner_ids)]" 
                           context="{'active_test': False}"
                           options="{'no_create': True}"/>
                </group>
                <notebook>
                    <page string="Target Customers">
                        <div class="mb-2">
                            <button string="Select All"
                                    name="action_select_all"
                                    type="object"
                                    class="btn btn-secondary btn-sm me-2"
                                    icon="fa-check-square-o"/>
                            <button string="Deselect All"
                                    name="action_deselect_all"
                                    type="object"
                                    class="btn btn-secondary btn-sm"
                                    icon="fa-square-o"/>
                        </div>


                        <field name="line_ids">
                            <list editable="bottom" create="false" delete="true">
                                <field name="selected" widget="boolean_toggle"/>


                                <field name="customer_code" string="Customer Code" readonly="1" force_save="1"/>
                                <field name="partner_id" string="Customer Name" readonly="1" force_save="1"/>
                                <!--<field name="customer_lifecycle_status" string="Customer Status" readonly="1" force_save="1"/>-->
                                <field name="house_no" string="House No" readonly="1" force_save="1"/>
                                <field name="street" string="Street" readonly="1" force_save="1"/>
                                <field name="city" string="City" readonly="1" force_save="1"/>
                                <field name="zip" string="Postcode" readonly="1" force_save="1"/>
                                <field name="phone" string="Phone" readonly="1" force_save="1"/>
                                <field name="status_code" string="Customer Status" readonly="1" force_save="1"/>
                            </list>
                        </field>
                    </page>
                </notebook>

                <footer>
                    <button string="Transfer Customers" name="process_round_change" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- SUMMARY POPUP DIALOG VIEW -->
    <record id="view_wizard_bulk_round_summary_form" model="ir.ui.view">
        <field name="name">wizard.bulk.round.summary.form</field>
        <field name="model">wizard.bulk.round.summary</field>
        <field name="arch" type="xml">
            <form string="Transfer Summary">
                <div class="bg-success-subtle border border-success rounded text-center p-3 mb-3">
                    <h4 class="mb-1">
                        <i class="fa fa-check-circle me-1" title="Success"/>
                        Transfer Successful!
                    </h4>
                    <field name="message" nolabel="1" class="fw-bold"/>
                </div>

                <group>
                    <group>
                        <field name="old_round_name" string="From Round"/>
                        <field name="new_round_name" string="To Round"/>
                    </group>
                    <group>
                        <field name="transferred_count" string="Total Customers Moved" class="fw-bold text-success" style="font-size: 18px;"/>
                    </group>
                </group>

                <footer>
                    <button string="OK" class="btn-primary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- MASS ASSIGN ROUND TO SALE ORDERS FORM -->
    <record id="view_bulk_round_change_wizard_form" model="ir.ui.view">
        <field name="name">bulk.round.change.wizard.form</field>
        <field name="model">bulk.round.change.wizard</field>
        <field name="arch" type="xml">
            <form string="Mass Assign Round to Sale Orders">
                <group>
                    <field name="round_id" options="{'no_create': True}"/>
                </group>
                <footer>
                    <button string="Apply Round" name="action_apply_round_change" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ACTIONS -->
    <record id="action_bulk_round_change_wizard" model="ir.actions.act_window">
        <field name="name">Bulk Round Change</field>
        <field name="res_model">bulk.round.change.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_view_types">list</field>
    </record>

    <record id="action_wizard_bulk_round_change" model="ir.actions.act_window">
        <field name="name">Bulk Customer Round Transfer</field>
        <field name="res_model">wizard.bulk.round.change</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
