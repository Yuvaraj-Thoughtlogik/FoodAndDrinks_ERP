<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="group_distribution_user" model="res.groups">
        <field name="name">Distribution User</field>
    </record>

    <record id="group_distribution_manager" model="res.groups">
        <field name="name">Distribution Manager</field>
        <field name="implied_ids"
               eval="[(4, ref('group_distribution_user'))]"/>
    </record>

    <record id="group_distribution_admin" model="res.groups">
        <field name="name">Distribution Administrator</field>
        <field name="implied_ids"
               eval="[(4, ref('group_distribution_manager'))]"/>
    </record>

</odoo>
