<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="view_partner_order_channel_log_form" model="ir.ui.view">
            <field name="name">partner.order.channel.log.form</field>
            <field name="model">partner.order.channel.log</field>
            <field name="arch" type="xml">
                <form name="Order Channel Logs" create="false" edit="false" delete="false">
                    <sheet>
                        <group>
                            <group>
                                <field name="change_date" readonly="1"/>
                                <field name="partner_id" readonly="1"/>
                                <field name="user_id" readonly="1"/>
                            </group>
                            <group>
                                <field name="previous_source_id" readonly="1"/>
                                <field name="current_source_id" readonly="1"/>
                                <field name="source_document" readonly="1"/>
                                <field name="source_ref" readonly="1"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="view_partner_order_channel_log_list" model="ir.ui.view">
            <field name="name">partner.order.channel.log.list</field>
            <field name="model">partner.order.channel.log</field>
            <field name="arch" type="xml">
                <list create="false" delete="false">
                    <field name="change_date" readonly="1"/>
                    <field name="partner_id" readonly="1"/>
                    <field name="previous_source_id" readonly="1"/>
                    <field name="current_source_id" readonly="1"/>
                    <field name="user_id" readonly="1"/>
                    <field name="source_document" readonly="1"/>

                    <field name="source_ref" readonly="1"/>
                </list>
            </field>
        </record>

        <record id="action_partner_order_channel_log" model="ir.actions.act_window">
            <field name="name">Order Channel Logs</field>
            <field name="res_model">partner.order.channel.log</field>
            <field name="view_mode">list,form</field>
        </record>
        <menuitem id="menu_partner_order_channel_log"
                  name="Order Channel Logs"
                  parent="contacts.menu_contacts"
                  action="action_partner_order_channel_log"
                  sequence="3"/>
        <record id="contacts.res_partner_menu_config" model="ir.ui.menu">
            <field name="sequence">10</field>
        </record>
    </data>
</odoo>