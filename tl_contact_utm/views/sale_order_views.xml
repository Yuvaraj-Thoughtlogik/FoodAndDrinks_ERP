<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="view_order_form_utm" model="ir.ui.view">
            <field name="name">sale.order.form.utm</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='validity_date']" position="before">
                    <field name="customer_source_id" string="Customer Source" options="{
                               'no_open': True,
                               'no_create': True,
                               'no_create_edit': True
                           }" readonly="True"/>
                </xpath>
                <xpath expr="//group[@name='sale_header']//group[@name='partner_details']//field[@name='partner_id']" position="after">
                    <field name="order_channel_id" string="Order Channel"
                           options="{
                               'no_open': True,
                               'no_create': True,
                               'no_create_edit': True
                           }"
                           readonly="state == 'sale'"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
