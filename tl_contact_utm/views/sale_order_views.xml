<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="view_order_form_utm" model="ir.ui.view">
            <field name="name">sale.order.form.utm</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet//group[@name='partner_details']//field[@name='partner_id']" position="after">
                    <field name="source_id" string="Customer Source"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>