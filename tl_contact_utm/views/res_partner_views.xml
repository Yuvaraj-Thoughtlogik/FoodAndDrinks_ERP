<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="view_partner_form_customer_source_log" model="ir.ui.view">
            <field name="name">res.partner.form.order.channel.log</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">

                <xpath expr="//div[@name='button_box']" position="inside">

                    <button type="object"
                            name="action_view_order_channel_logs"
                            class="oe_stat_button"
                            icon="fa-history">

                        <field name="order_channel_log_count"
                               widget="statinfo"
                               string="Order Channel Logs"/>

                    </button>

                </xpath>
                <xpath expr="//page[@name='sales_purchases']//group[@name='sale']" position="inside">
                    <field name="customer_source_id"/>
                    <field name="order_channel_id" readonly="True"/>
                </xpath>

            </field>
        </record>
    </data>
</odoo>