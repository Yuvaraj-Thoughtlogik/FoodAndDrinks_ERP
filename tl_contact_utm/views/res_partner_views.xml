<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="view_partner_form_customer_source_log" model="ir.ui.view">
            <field name="name">res.partner.form.order.channel.log</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">

                <xpath expr="//div[@name='button_box']" position="inside">

                    <button type="object"
                            name="action_view_order_channel_logs"
                            class="oe_stat_button"
                            icon="fa-history">

                        <field name="order_channel_log_count"
                               widget="statinfo"
                               string="Order Channel Logs"/>

                    </button>

                </xpath>
                <!-- Tel Number (landline); Phone is used as the mobile number. -->
                <xpath expr="//field[@name='website']" position="after">
                    <field name="tel_number" widget="phone"/>
                </xpath>
                <xpath expr="//field[@name='child_ids']//div[field[@name='phone']]" position="after">
                    <div class="d-flex align-items-baseline">
                        <i class="fa fa-fw me-1 fa-phone-square text-primary" title="Tel Number"/>
                        <field name="tel_number" widget="phone" class="w-100" placeholder="Tel Number"/>
                    </div>
                </xpath>
                <xpath expr="//page[@name='sales_purchases']//group[@name='sale']" position="inside">
                    <field name="partner_customer_source_id"  options="{
                               'no_open': True,
                               'no_create': True,
                               'no_create_edit': True
                           }"/>
                    <field name="order_channel_id" options="{
                               'no_open': True,
                               'no_create': True,
                               'no_create_edit': True
                           }" readonly="True"/>
                </xpath>

            </field>
        </record>
    </data>
</odoo>