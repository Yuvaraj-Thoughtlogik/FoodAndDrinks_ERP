<?xml version="1.0" encoding="utf-8"?>
<odoo>



    <record id="utm_source_view_search_custom" model="ir.ui.view">
        <field name="name">utm.source.view.search.custom</field>
        <field name="model">utm.source</field>
        <field name="arch" type="xml">
            <search string="Sources">
                <field name="name"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>


    <record id="utm.utm_source_action" model="ir.actions.act_window">
        <field name="search_view_id" ref="utm_source_view_search_custom"/>
    </record>



    <record id="utm_source_view_tree_inherit_sequence" model="ir.ui.view">
        <field name="name">utm.source.view.tree.inherit.sequence</field>
        <field name="model">utm.source</field>
        <field name="inherit_id" ref="utm.utm_source_view_tree"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='name']" position="before">
                <field name="sequence" widget="handle"/>
            </xpath>

        </field>
    </record>


    <menuitem id="menu_contacts_utm_source"
              name="Order Channels"
              parent="contacts.res_partner_menu_config"
              action="utm.utm_source_action"
              sequence="4"/>

</odoo>