<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="tl_save_discard_but.FormStatusIndicator"
       t-inherit="web.FormStatusIndicator"
       t-inherit-mode="extension">

        <xpath expr="//div[hasclass('o_form_status_indicator')]" position="attributes">
            <attribute name="class">
                o_form_status_indicator d-flex align-items-center me-auto
            </attribute>
        </xpath>

        <xpath expr="//button[hasclass('o_form_button_save')]" position="attributes">
            <attribute name="class">
                o_form_button_save btn d-inline-flex align-items-center justify-content-center px-2 py-1 border-0
            </attribute>
        </xpath>

        <xpath expr="//button[hasclass('o_form_button_cancel')]" position="attributes">
            <attribute name="class">
                o_form_button_cancel btn d-inline-flex align-items-center justify-content-center px-2 py-1 border-0
            </attribute>
        </xpath>

    </t>

    <t t-name="leas_form_status_indicator"
       t-inherit="web.FormStatusIndicator"
       t-inherit-mode="extension">

        <xpath expr="//button[hasclass('o_form_button_save')]/i" position="after">
            <span class="save_button ms-1">Save</span>
        </xpath>

        <xpath expr="//button/i[hasclass('fa-times')]" position="after">
            <span class="discard_button ms-1">Discard</span>
        </xpath>

    </t>

</templates>
