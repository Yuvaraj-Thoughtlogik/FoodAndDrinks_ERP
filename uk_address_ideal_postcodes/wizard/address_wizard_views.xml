<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_uk_address_wizard_form" model="ir.ui.view">
        <field name="name">uk.address.wizard.form</field>
        <field name="model">uk.address.wizard</field>
        <field name="arch" type="xml">
            <form string="Select Matching Address">
                <sheet>
                    <group>
                        <field name="partner_id" invisible="1"/>
                        <field name="option_id" 
                               widget="selection" 
                               string="Matching Addresses" 
                               placeholder="Choose matching address..."/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_apply_address" 
                            string="Apply Address" 
                            type="object" 
                            class="btn-primary"/>
                    <button string="Cancel" 
                            class="btn-secondary" 
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
