<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form_uk_address" model="ir.ui.view">
        <field name="name">res.partner.form.uk.address</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="priority">99</field>

        <field name="arch" type="xml">

            <!-- Replace Odoo standard address layout -->
            <xpath expr="//div[hasclass('o_address_format')]" position="replace">

                <div class="uk_address_format"
                     style="width: 100% !important;">

                    <!-- Street -->
                    <field name="street"
                           placeholder="Door No..."
                           class="o_address_street"/>

                    <!-- Street 2 -->
                    <field name="street2"
                           placeholder="Street..."
                           class="o_address_street"/>

                    <!-- City -->
                    <field name="city"
                           placeholder="City"
                           class="o_address_city"/>

                    <!-- State -->
                    <field name="state_id"
                           placeholder="State"
                           class="o_address_state_id"
                           options="{'no_open': True, 'no_quick_create': True}"
                           context="{
                               'country_id': country_id,
                               'default_country_id': country_id,
                               'zip': zip
                           }"/>

                    <!-- Country -->
                    <field name="country_id"
                           placeholder="Country"
                           class="o_address_country_id"
                           options="{
                               'no_open': True,
                               'no_create': True
                           }"/>

                    <!-- ZIP + Lookup Address -->
                    <div class="d-inline-flex align-items-center"
                         style="
                             display: inline-flex !important;
                             flex-direction: row !important;
                             align-items: center !important;
                             white-space: nowrap !important;
                             width: auto !important;
                             margin-top: 4px !important;
                         ">

                        <!-- ZIP / POSTCODE -->
                        <field name="zip"
                               placeholder="ZIP / Postcode"
                               class="o_address_zip me-1"
                               style="
                                   width: 110px !important;
                                   min-width: 110px !important;
                                   max-width: 110px !important;
                                   display: inline-block !important;
                                   vertical-align: middle !important;
                               "/>

                        <!-- LOOKUP ADDRESS -->
                        <button name="action_lookup_uk_address"
                                type="object"
                                string="Lookup Address"
                                class="btn-primary btn-sm"
                                icon="fa-search"
                                title="Lookup UK Address"
                                style="
                                    display: inline-block !important;
                                    vertical-align: middle !important;
                                    white-space: nowrap !important;
                                    margin: 0 !important;
                                "/>

                    </div>

                </div>

            </xpath>

        </field>
    </record>


    <!-- UK Address Lookup Wizard -->
    <record id="view_uk_address_lookup_wizard_form"
            model="ir.ui.view">

        <field name="name">uk.address.lookup.wizard.form</field>
        <field name="model">uk.address.lookup.wizard</field>

        <field name="arch" type="xml">

            <form string="Select Matching Address">

                <sheet>
                    <group>

                        <field name="selected_line_id"
                               widget="selection"
                               domain="[('wizard_id', '=', id)]"
                               options="{'no_create': True}"
                               string="Choose Address"/>

                    </group>
                </sheet>

                <footer>

                    <button name="action_apply_address"
                            string="Apply Address"
                            type="object"
                            class="btn-primary"/>

                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>

                </footer>

            </form>

        </field>
    </record>

</odoo>
