<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 1. UK Address Partner Form Inheritance -->
    <record id="view_partner_form_uk_address" model="ir.ui.view">
            <field name="name">res.partner.form.uk.address</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="priority">99</field>
            <field name="arch" type="xml">

                
                <xpath expr="//div[hasclass('o_address_format')]/field[@name='zip']" position="attributes">
                    <attribute name="style">width: 30% !important; display: inline-block !important; vertical-align: middle !important;</attribute>
                    <attribute name="class">o_address_zip me-1</attribute>
                </xpath>

                
                <xpath expr="//div[hasclass('o_address_format')]/field[@name='zip']" position="after">
                    <button name="action_lookup_uk_address" 
                            type="object" 
                            string="Lookup Address" 
                            class="btn-primary btn-sm align-middle me-1" 
                            style="vertical-align: middle !important; margin-top: -3px;"
                            icon="fa-search"
                            title="Lookup UK Address"/>
                </xpath>

            </field>
        </record>

   
    <record id="view_uk_address_lookup_wizard_form" model="ir.ui.view">
        <field name="name">uk.address.lookup.wizard.form</field>
        <field name="model">uk.address.lookup.wizard</field>
        <field name="arch" type="xml">
            <form string="Select Matching Address">
                <sheet>
                    <group>
                        <field name="selected_line_id" 
                               widget="selection" 
                               domain="[('wizard_id', '=', id)]" 
                               options="{'no_create': True}" 
                               string="Choose Address"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_apply_address" string="Apply Address" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
