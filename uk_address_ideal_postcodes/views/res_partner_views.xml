<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_uk_address" model="ir.ui.view">
        <field name="name">res.partner.form.uk.address</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='street']" position="before">
                <div class="o_row" groups="base.group_user">
                    <field name="lookup_postcode_input" placeholder="UK Postcode e.g. SW1A 1AA" invisible="1"/>
                    <button name="action_lookup_uk_address" 
                            type="object" 
                            string="Lookup Address" 
                            class="btn-primary ms-2" 
                            icon="fa-search"/>
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_uk_address_lookup_wizard_form" model="ir.ui.view">
        <field name="name">uk.address.lookup.wizard.form</field>
        <field name="model">uk.address.lookup.wizard</field>
        <field name="arch" type="xml">
            <form string="Select Matching Address">
                <sheet>
                    <group>
                        <field name="selected_line_id" 
                               widget="selection" 
                               domain="[('wizard_id', '=', id)]" 
                               options="{'no_create': True}" 
                               string="Choose Address"/>
                    </group>
                    <field name="line_ids" readonly="1">
                        <list decoration-info="1">
                            <field name="line_1"/>
                            <field name="line_2"/>
                            <field name="post_town"/>
                            <field name="postcode"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_apply_address" string="Apply Address" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
