<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_uk_address" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.uk.address</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="UK Address Lookup" string="UK Address Lookup" name="uk_address_lookup">
                    <block title="Ideal Postcodes Configuration">
                        <setting id="ideal_postcodes_setting" help="Configure API credentials for UK PAF lookup.">
                            <field name="ideal_postcodes_api_key"/>
                            <div class="mt-2">
                                <button name="action_test_ideal_postcodes_key" 
                                        type="object" 
                                        string="Test API Connection" 
                                        class="btn-link" 
                                        icon="fa-plug"/>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
