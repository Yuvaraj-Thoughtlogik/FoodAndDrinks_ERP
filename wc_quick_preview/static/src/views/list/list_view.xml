<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-inherit="web.ListRenderer" t-inherit-mode="extension" owl="1">
        <xpath expr="//th[hasclass('o_list_record_selector')]" position="after">
            <th class="o_wc_view_column text-center align-middle" style="width: 40px;">
                View
            </th>
        </xpath>
    </t>

      <t t-inherit="web.ListRenderer.RecordRow" t-inherit-mode="extension" owl="1">
        <xpath expr="//td[hasclass('o_list_record_selector')]" position="after">
            <td class="o_wc_view_column text-center">
                <a class="fa fa-eye cursor-pointer"
                   aria-label="Open"
                   title="Open"
                   t-on-click.stop="(ev) => this.onEyeCellClicked(record, ev)"/>
            </td>
        </xpath>
    </t>


      <t t-inherit="sale.SaleListRenderer" t-inherit-mode="extension" owl="1">
        <xpath expr="//th[hasclass('o_list_record_selector')]" position="after">
            <th class="o_wc_view_column text-center align-middle" style="width: 40px;">
                View
            </th>
        </xpath>
    </t>

      <t t-inherit="account.FileUploadListRenderer" t-inherit-mode="extension" owl="1">
        <xpath expr="//th[hasclass('o_list_record_selector')]" position="after">
            <th class="o_wc_view_column text-center align-middle" style="width: 40px;">
                View
            </th>
        </xpath>
    </t>

</templates>