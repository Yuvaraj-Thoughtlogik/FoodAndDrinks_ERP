<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==========================================================
         Address Tree
    =========================================================== -->

    <record id="view_postcode_lookup_line_tree" model="ir.ui.view">
        <field name="name">uk.postcode.lookup.line.tree</field>
        <field name="model">uk.postcode.lookup.line</field>
        <field name="arch" type="xml">

            <list create="false"
                  delete="false"
                  edit="false">

                <button
                    name="action_select"
                    type="object"
                    string="Select"
                    icon="fa-check"
                    class="btn-primary"/>

                <field name="line1"/>
                <field name="line2"/>
                <field name="line3"/>
                <field name="city"/>
                <field name="county"/>
                <field name="postcode"/>

            </list>

        </field>
    </record>


    <!-- ==========================================================
         Wizard Form
    =========================================================== -->

    <record id="view_postcode_lookup_wizard_form" model="ir.ui.view">
        <field name="name">uk.postcode.lookup.wizard.form</field>
        <field name="model">uk.postcode.lookup.wizard</field>
        <field name="arch" type="xml">
            <form string="Select Address">

                <sheet>

                    <group>
                        <field name="postcode" readonly="1"/>
                    </group>

                    <field name="line_ids" nolabel="1">
                        <list create="false" edit="false" delete="false">

                            <button
                                name="action_select"
                                type="object"
                                string="Select"
                                icon="fa-check"/>

                            <field name="line1"/>
                            <field name="line2"/>
                            <field name="city"/>
                            <field name="county"/>
                            <field name="postcode"/>

                        </list>
                    </field>

                </sheet>

                <footer>
                    <button string="Close"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>

            </form>
        </field>
    </record>


    <!-- ==========================================================
         Window Action
    =========================================================== -->

    <record id="action_postcode_lookup_wizard" model="ir.actions.act_window">
    <field name="name">UK Address Lookup</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">uk.postcode.lookup.wizard</field>
    <field name="view_mode">form</field>
    <field name="view_id" ref="view_postcode_lookup_wizard_form"/>
    <field name="target">new</field>
</record>

</odoo>
