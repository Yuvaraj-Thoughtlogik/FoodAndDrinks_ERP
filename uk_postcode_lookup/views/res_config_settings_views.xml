<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_uk_postcode"
            model="ir.ui.view">
        <field name="name">res.config.settings.uk.postcode</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//form" position="inside">

                <app string="UK Address Lookup" name="uk_postcode_lookup">

                    <block title="Provider Settings">

                        <setting string="Enable Address Lookup">

                            <field name="uk_postcode_enabled"/>

                        </setting>

                        <setting string="Provider">

                            <field name="uk_postcode_provider"/>

                        </setting>

                        <setting string="API Key">

                            <field name="uk_postcode_api_key"
                                   password="True"/>

                        </setting>

                        <setting string="Request Timeout">

                            <field name="uk_postcode_timeout"/>

                        </setting>

                        <setting string="API Base URL">

                            <field name="uk_postcode_base_url"/>

                        </setting>

                    </block>

                </app>

            </xpath>

        </field>

    </record>

</odoo>
