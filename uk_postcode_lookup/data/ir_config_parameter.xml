<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Enable UK Address Lookup -->
    <record id="param_uk_postcode_enabled" model="ir.config_parameter">
        <field name="key">uk_postcode_lookup.enabled</field>
        <field name="value">True</field>
    </record>

    <!-- Default Provider -->
    <record id="param_uk_postcode_provider" model="ir.config_parameter">
        <field name="key">uk_postcode_lookup.provider</field>
        <field name="value">ideal_postcodes</field>
    </record>

    <!-- Default Timeout -->
    <record id="param_uk_postcode_timeout" model="ir.config_parameter">
        <field name="key">uk_postcode_lookup.timeout</field>
        <field name="value">15</field>
    </record>

    <!-- Default Base URL -->
    <record id="param_uk_postcode_base_url" model="ir.config_parameter">
        <field name="key">uk_postcode_lookup.base_url</field>
        <field name="value">https://api.ideal-postcodes.co.uk/v1</field>
    </record>

    <!-- Empty API Key (administrator must configure) -->
    <record id="param_uk_postcode_api_key" model="ir.config_parameter">
        <field name="key">uk_postcode_lookup.api_key</field>
        <field name="value"></field>
    </record>

</odoo>
