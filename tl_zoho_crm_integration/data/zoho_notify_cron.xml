<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Zoho notification channels expire after at most a week: renew them in time. -->
    <record id="ir_cron_zoho_renew_notifications" model="ir.cron">
        <field name="name">Zoho: Renew Live Notification Channels</field>
        <field name="model_id" ref="tl_odoo_zoho_integration.model_zoho_config_schedule"/>
        <field name="state">code</field>
        <field name="code">model._cron_renew_live_notifications()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
