<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_zoho_live_status_form" model="ir.ui.view">
        <field name="name">zoho.live.status.form</field>
        <field name="model">zoho.live.status</field>
        <field name="arch" type="xml">
            <form string="Live Sync Status">
                <field name="report" nolabel="1"/>
                <footer>
                    <button name="action_refresh" type="object" string="Check Again" class="btn-primary" icon="fa-refresh"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
