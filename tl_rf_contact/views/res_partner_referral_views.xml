<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Referral master -->
    <record id="view_res_partner_referral_list" model="ir.ui.view">
        <field name="name">res.partner.referral.list</field>
        <field name="model">res.partner.referral</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_res_partner_referral" model="ir.actions.act_window">
        <field name="name">Referrals</field>
        <field name="res_model">res.partner.referral</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_res_partner_referral"
              name="Referrals"
              parent="contacts.res_partner_menu_config"
              action="action_res_partner_referral"
              sequence="50"/>

    <!-- Referral lines -->
    <record id="view_res_partner_referral_line_list" model="ir.ui.view">
        <field name="name">res.partner.referral.line.list</field>
        <field name="model">res.partner.referral.line</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name" readonly="1"/>
                <field name="referral_id"/>
                <field name="partner_id" column_invisible="context.get('hide_partner')"/>
                <field name="type"/>
                <field name="related_partner_id"/>
                <field name="date"/>
                <field name="user_id"/>
                <field name="linked_line_id" optional="hide" readonly="1"/>
            </list>
        </field>
    </record>

    <!-- Contact form: Referrals page -->
    <record id="view_partner_form_inherit_referral" model="ir.ui.view">
        <field name="name">res.partner.form.referral</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='internal_notes']" position="after">
                <page name="referrals" string="Referrals">
                    <field name="referral_line_ids" context="{'hide_partner': True}">
                        <list editable="bottom">
                            <field name="referral_id"/>
                            <field name="name" readonly="1" optional="hide"/>
                            <field name="type"/>
                            <field name="related_partner_id"/>
                            <field name="date"/>
                            <field name="user_id"/>
                            <field name="linked_line_id" optional="hide" readonly="1"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
