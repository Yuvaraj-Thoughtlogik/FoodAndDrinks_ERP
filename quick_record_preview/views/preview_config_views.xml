<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_preview_config_tree" model="ir.ui.view">
        <field name="name">preview.config.tree</field>
        <field name="model">preview.config</field>
        <field name="arch" type="xml">
            <list string="Preview Configuration">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="model_id"/>
                <field name="show_image"/>
                <field name="show_display_name"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_preview_config_form" model="ir.ui.view">
        <field name="name">preview.config.form</field>
        <field name="model">preview.config</field>
        <field name="arch" type="xml">
            <form string="Preview Configuration">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="model_id" options="{'no_create': True}"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="show_image"/>
                            <field name="show_display_name"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Fields to Show">
                            <field name="field_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_preview_config" model="ir.actions.act_window">
        <field name="name">Preview Configuration</field>
        <field name="res_model">preview.config</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new preview configuration
            </p>
            <p>
                Configure which fields to show in the Quick Record Preview popup for each model.
                By default, the preview shows the image (if available) and display_name.
            </p>
        </field>
    </record>
</odoo>

